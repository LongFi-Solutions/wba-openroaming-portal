{% extends 'landing/base.html.twig' %}

{% block title %}
    {{ data.PAGE_TITLE.value }}
{% endblock %}

{% block second_col %}
    <div class="leading-7 mb-6">
        <p class="font-bold text-lg">{{ 'coverageMap.title'|trans({}, 'landing') }}</p>
        <p class="mt-3">{{ 'coverageMap.description'|trans({}, 'landing') }}</p>
    </div>

    <div class="relative z-0 overflow-hidden w-full h-[500px] rounded-[1px] shadow-lg"
            {% if needsBrowserGeolocation %}
                {{ stimulus_controller('geolocation') }}
            {% endif %}
    >
        {{ ux_map(map, {
            style: 'height: 100%; width: 100%;',
        }) }}
    </div>

    <div class="mt-6">
        <a href="{{ path('app_landing') }}" class="btn-secondary inline-flex items-center gap-2">
            {{ 'coverageMap.backToPortal'|trans({}, 'landing') }}
        </a>
    </div>
{% endblock %}
