{% extends 'base.html.twig' %}

{% block title %}
    {{ data.PAGE_TITLE.value }}
{% endblock %}

{% set bgUrl = data.WALLPAPER_IMAGE.value != '/resources/images/wallpaper.png'
    ? data.WALLPAPER_IMAGE.value
    : '/resources/images/background.png' %}

{% block body %}
    <div class="min-h-screen bg-center bg-cover flex items-center justify-center px-4 sm:px-6 lg:px-8"
         style="background-image: url('{{ bgUrl }}');">
        <div class="landing-container">
            <div
                    {% if hasLocationConsent and centerLat is null %}
                        {{ stimulus_controller('geolocation') }}
                    {% endif %}
                    data-center-lat="{{ centerLat }}"
                    data-center-lng="{{ centerLng }}"
            >
                {# map renders here, reading data-center-lat/lng, falling back to a default if both are empty #}
            </div>
        </div>
    </div>
{% endblock %}
