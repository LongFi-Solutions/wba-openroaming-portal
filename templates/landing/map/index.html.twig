{% extends 'base.html.twig' %}

{% block title %}
    {{ data.PAGE_TITLE.value }}
{% endblock %}

{% set bgUrl = data.WALLPAPER_IMAGE.value != '/resources/images/wallpaper.png'
    ? data.WALLPAPER_IMAGE.value
    : '/resources/images/background.png' %}

{% block body %}
    <div class="min-h-screen bg-center bg-cover flex items-center justify-center px-4 sm:px-6 lg:px-8"
         style="background-image: url('{{ bgUrl }}');">

        <div class="landing-container">

            {# Header #}
            <div class="landing-header">
                <h1 class="instructions-title md:mb-10 mb-4">
                    {{ 'coverageMap.title'|trans({}, 'landing') }}
                </h1>

                <div class="landing-language-selector md:mb-10 mb-4">
                    {{ include('shared/_select_language.html.twig', {
                        currentLocale: app.request.locale,
                        routeName: 'app_change_language',
                        warningMessage: false,
                    }) }}
                </div>
            </div>

            {# Content Area #}
            <div class="instructions-content">
                {# Cookie Banner #}
                {% block cookie %}
                    <div class="grid grid-cols-1 mx-6 gap-[5px] break-words">
                        {% if isEEAUser() != constant('App\\Enum\\GeoLocation\\IsEEAHandler::NOT_IN_EEA').value %}
                            {{ include('landing/shared/_cookie_banner.html.twig') }}
                        {% endif %}
                    </div>
                {% endblock %}

                <div class="my-6">
                    <p>{{ 'coverageMap.description'|trans({}, 'landing') }}</p>
                    <p class="mt-2 text-sm text-[#707070]">
                        {{ 'coverageMap.clickHint'|trans({}, 'landing') }}
                    </p>
                </div>

                <div class="relative z-0 overflow-hidden w-full h-[500px] rounded-2xl shadow-lg coverage-map-public"
                        {% if needsBrowserGeolocation %}
                            {{ stimulus_controller('coverage-map-style')|stimulus_controller('geolocation') }}
                        {% else %}
                            {{ stimulus_controller('coverage-map-style') }}
                        {% endif %}
                >
                    {{ ux_map(map, {
                        style: 'height: 100%; width: 100%;',
                    }) }}
                </div>

                <div class="mt-6 px-6 pb-6">
                    <a href="{{ path('app_landing') }}" class="btn-secondary inline-flex items-center gap-2">
                        {{ 'coverageMap.backToPortal'|trans({}, 'landing') }}
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
