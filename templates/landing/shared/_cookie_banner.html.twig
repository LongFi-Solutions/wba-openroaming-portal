<div {{ stimulus_controller('cookie') }}>
    <div class="flex items-center justify-center relative">

        {# Cookie Banner #}
        <div {{ stimulus_target('cookie', 'bannerWrapper') }} class="flex items-center justify-center relative">
            <section
                    class="w-full p-5 mt-8 bg-slate-200 duration-100 rounded hover:shadow z-10 flex flex-col justify-between">
                <div class="md:flex items-center justify-between text-center md:text-left text-xs mb-4">
                    <div class="md:flex-1">
                        {{ 'text'|trans({}, '_cookie_banner') }}
                    </div>
                </div>
                <div class="flex flex-col md:flex-row justify-center md:space-x-4 space-x-0 space-y-4 md:space-y-0">
                    <button class="py-1 px-2 btn-primary text-sm" data-action="cookie#acceptCookies">
                        {{ 'accept'|trans({}, '_cookie_banner') }}
                    </button>
                    <button class="py-1 px-2 btn-logout text-sm" data-action="cookie#rejectCookies">
                        {{ 'reject'|trans({}, '_cookie_banner') }}
                    </button>
                    <button class="py-1 px-2 btn-secondary text-sm" data-action="cookie#showModal">
                        {{ 'settings'|trans({}, '_cookie_banner') }}
                    </button>
                </div>
            </section>
        </div>

        {# Cookie Preferences Modal #}
        <div class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50" {{ stimulus_target('cookie', 'modalCookie') }}>
            <div class="px-10 py-[35px] h-[calc(90%)] lg:h-[calc(80%)] w-[810px] bg-white lg:w-1/2 p-6 mx-4 rounded-2xl shadow space-y-4 overflow-auto">
                <div class="flex justify-between items-center border-b pb-3">
                    <h2 class="text-primary text-xl font-semibold">
                        {{ 'title'|trans({}, '_cookie_banner') }}
                    </h2>
                    <button type="button"
                            class="ml-auto flex flex-row justify-end gap-x-[12px] items-center text-[#707070]"
                            {{ stimulus_action('cookie', 'closeModal') }}>
                        <span>{{ 'close'|trans({}, '_cookie_banner') }}</span>
                        <twig:ux:icon name="wba:cross-circle-rounded" class="w-6 h-auto fill-current"/>
                    </button>
                </div>

                <div class="flex justify-center">
                    {% if data.CUSTOMER_LOGO_ENABLED.value == constant('App\\Enum\\OperationMode::ON').value %}
                        <img class="w-[170px] h-[58px] object-scale-down object-right my-4"
                             src="{{ data.CUSTOMER_LOGO.value }}" alt="Logo"/>
                    {% endif %}
                </div>

                <div class="text-center text-sm text-gray-700">
                    <p>
                        {{ 'cookiesDescription'|trans({}, '_cookie_banner') }}
                    </p>
                </div>

                <div {{ stimulus_target('cookie', 'consentForm') }}>
                    <div class="flex flex-col mx-4 space-y-4">

                        {# Necessary Cookies Section #}
                        <div class="flex flex-col space-y-3">
                            <h3 class="text-lg font-semibold">{{ 'subTitle'|trans({}, '_cookie_banner') }}</h3>
                            <p class="text-sm">
                                {{ 'essentialCookiesText'|trans({}, '_cookie_banner') }}
                            </p>
                            <ul class="list-disc list-inside text-sm space-y-2">
                                {# PHPSESSID #}
                                <li>
                                    <strong>{{ 'sessionCookie.title'|trans({}, '_cookie_banner') }}</strong> -
                                    {{ 'sessionCookie.description'|trans({}, '_cookie_banner') }}
                                    <span>
                                        <br>
                                        {{ 'controlledBy'|trans({}, '_cookie_banner') }}:
                                        <a
                                                class="underline text-primary font-semibold"
                                                href="{{ absolute_url(path('app_landing')) }}">
                                            {{ app.request.getHost() }}
                                        </a>
                                    </span>
                                    <br>
                                    <p>
                                        <a
                                                href="{{ path('app_privacy_policy') }}"
                                                class="underline text-primary"
                                                target="_blank">
                                            {{ 'privacyPolicy'|trans({}, '_cookie_banner') }}
                                        </a>
                                    </p>
                                </li>
                                {# CSRF #}
                                <li>
                                    <strong>{{ 'csrfToken.title'|trans({}, '_cookie_banner') }}</strong> -
                                    {{ 'csrfToken.description'|trans({}, '_cookie_banner') }}
                                    <span>
                                        <br>
                                        {{ 'controlledBy'|trans({}, '_cookie_banner') }}:
                                        <a
                                                class="underline text-primary font-semibold"
                                                href="{{ absolute_url(path('app_landing')) }}">
                                            {{ app.request.getHost() }}
                                        </a>
                                    </span>
                                    <br>
                                    <p>
                                        <a
                                                href="{{ path('app_privacy_policy') }}"
                                                class="underline text-primary"
                                                target="_blank">
                                            {{ 'privacyPolicy'|trans({}, '_cookie_banner') }}
                                        </a>
                                    </p>
                                </li>
                                {# ST Redirect Cookie
                                <li>
                                    <strong>ST Redirect Cookie</strong> - Temporarily stores redirect URLs to ensure
                                    users are redirected
                                    to the intended page after completing specific actions, such as logging in or
                                    submitting a form.
                                    <span>
                                        <br>
                                        Controlled by:
                                        <a
                                                class="underline text-primary font-semibold"
                                                href="{{ absolute_url(path('app_landing')) }}">
                                            {{ app.request.getHost() }}
                                        </a>
                                    </span>
                                    <br>
                                    <p>
                                        <a
                                                href="{{ path('app_privacy_policy') }}"
                                                class="underline text-primary"
                                                target="_blank">
                                            Privacy Policy
                                        </a>
                                    </p>
                                </li>
                                #}
                                {# SAML Session Cookie #}
                                <li>
                                    <strong>{{ 'samlSessionCookie.title'|trans({}, '_cookie_banner') }}</strong> -
                                    {{ 'samlSessionCookie.description'|trans({}, '_cookie_banner') }}
                                    <span>
                                        <br>
                                        {{ 'controlledBy'|trans({}, '_cookie_banner') }}:
                                        <a class="underline text-primary font-semibold"
                                           href="{{ absolute_url(path('app_landing')) }}">
                                            {{ app.request.getHost() }}
                                        </a>
                                    </span>
                                    <br>
                                    <p>
                                        <a href="{{ path('app_privacy_policy') }}"
                                           class="underline text-primary"
                                           target="_blank">
                                            {{ 'privacyPolicy'|trans({}, '_cookie_banner') }}
                                        </a>
                                    </p>
                                </li>
                                {# JWT Authentication - API Cookie #}
                                <li>
                                    <strong>{{ 'jwtAuthenticationCookie.title'|trans({}, '_cookie_banner') }}</strong> -
                                    {{ 'jwtAuthenticationCookie.description'|trans({}, '_cookie_banner') }}
                                    <span>
                                        <br>
                                        {{ 'controlledBy'|trans({}, '_cookie_banner') }}:
                                        <a class="underline text-primary font-semibold"
                                           href="{{ absolute_url(path('app_landing')) }}">
                                            {{ app.request.getHost() }}
                                        </a>
                                    </span>
                                    <br>
                                    <p>
                                        <a href="{{ path('app_privacy_policy') }}"
                                           class="underline text-primary"
                                           target="_blank">
                                            {{ 'privacyPolicy'|trans({}, '_cookie_banner') }}
                                        </a>
                                    </p>
                                </li>
                                {# Turnstile Cookie #}
                                <li>
                                    <strong>{{ 'turnstileCookie.title'|trans({}, '_cookie_banner') }}</strong> -
                                    {{ 'turnstileCookie.description'|trans({}, '_cookie_banner') }}
                                    <span>
                                    <br>
                                        {{ 'controlledBy'|trans({}, '_cookie_banner') }}:
                                        <a class="underline text-primary font-semibold"
                                           href="https://www.cloudflare.com/application-services/products/turnstile/"
                                           target="_blank">
                                            CloudFlare Turnstile
                                        </a>
                                    </span>
                                    <br>
                                    <p>
                                        <a href="https://www.cloudflare.com/privacypolicy/"
                                           class="underline text-primary"
                                           target="_blank">
                                            {{ 'privacyPolicy'|trans({}, '_cookie_banner') }}
                                        </a>
                                    </p>
                                </li>
                            </ul>
                        </div>

                        {# Manageable Cookies #}
                        <div class="flex flex-col space-y-3">
                            <h3 class="font-semibold">{{ 'manageableCookiesTitle'|trans({}, '_cookie_banner') }}</h3>
                            <p class="text-sm">
                                {{ 'manageableCookiesDescription'|trans({}, '_cookie_banner') }}
                            </p>
                            <ul class="text-sm space-y-4"> {# Alterado para space-y-4 para dar mais respiro entre items #}
                                {# Remember Me Session Cookie #}
                                <li>
                                    <div class="flex justify-between items-center">
                                        <div>
                                            <strong>{{ 'rememberMeCookie.title'|trans({}, '_cookie_banner') }}</strong>
                                            -
                                            {{ 'rememberMeCookie.description'|trans({}, '_cookie_banner') }}
                                            <span>
                                                <br>
                                                {{ 'controlledBy'|trans({}, '_cookie_banner') }}:
                                                <a class="underline text-primary font-semibold"
                                                   href="{{ absolute_url(path('app_landing')) }}">
                                                    {{ app.request.getHost() }}
                                                </a>
                                            </span>
                                            <br>
                                            <p>
                                                <a href="{{ path('app_privacy_policy') }}"
                                                   class="underline text-primary"
                                                   target="_blank">
                                                    {{ 'privacyPolicy'|trans({}, '_cookie_banner') }}
                                                </a>
                                            </p>
                                        </div>
                                        <div>
                                            <label class="inline-flex items-center cursor-pointer">
                                                <input type="checkbox" class="sr-only peer" data-scope="rememberMe">
                                                <div class="ms-2 relative w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-bg-lightGreen rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#68D391]"></div>
                                            </label>
                                        </div>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>

                    {# Apply Cookies #}
                    <div class="mt-10">
                        <div class="md:flex md:justify-between justify-cente items-centerr">
                            <div class="md:flex-1 text-center md:text-left text-xs">
                                {{ 'dataSafetyText'|trans({}, '_cookie_banner') }}
                                <a href="{{ path('app_privacy_policy') }}" target="_blank"
                                   class="underline text-primary font-semibold">
                                    {{ 'privacyPolicy'|trans({}, '_cookie_banner') }}
                                </a>
                            </div>
                            <div class="mt-3 flex flex-col md:flex-row justify-center md:space-x-4 space-x-0 space-y-4 md:space-y-0">
                                <button class="mt-4 md:mt-0 btn-primary" data-action="cookie#savePreferences">
                                    {{ 'apply'|trans({}, '_cookie_banner') }}
                                </button>
                                <button class="mt-4 md:mt-0 btn-logout" data-action="cookie#rejectCookies">
                                    {{ 'reject'|trans({}, '_cookie_banner') }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Cookie Open Modal Cookie Setting #}
    <div class="flex flex-row items-center gap-4 my-2 w-full" data-cookie-target="manageButton">
        <div class="flex items-center gap-2 ml-auto">
            <span class="text-sm text-[#707070]">{{ 'manage'|trans({}, '_cookie_banner') }}</span>
            <button id="modalManageCookies" type="button" data-action="cookie#showModal"
                    class="flex items-center duration-300 cursor-pointer rounded-full text-[#707070] focus:animate-spin-slow focus:bg-[#7DB928] focus:text-white hover:shadow-lg p-2.5 relative z-0">
                <twig:ux:icon name="wba:cookie" class="stroke-current"/>
            </button>
        </div>
    </div>
</div>
