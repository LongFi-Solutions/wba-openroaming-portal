{% import 'dashboard/shared/_sort_arrow.html.twig' as sharedSort %}
<div {{ attributes }}>

    <div class="sm:w-auto px-5 py-4">
        <div class="flex flex-col lg:flex-row justify-between items-center space-y-6 lg:space-y-0 sm:space-x-4">

            {# Left Filter Tabs #}
            <div class="flex flex-col md:flex-row sm:items-center gap-4 sm:gap-6">
                {% set tabs = {
                    all: {
                        label: 'all',
                        count: this.userCounts.all,
                        activeClass: 'border-b-2 border-y-veryDarkButton',
                        hoverClass: 'hover:border-b-2 hover:border-y-veryDarkButton',
                        badgeActive: 'bg-veryDarkButton text-white',
                        badgeHover: 'group-hover:bg-veryDarkButton group-hover:text-white',
                    },
                    Verified: {
                        label: 'verified',
                        count: this.userCounts.verified,
                        activeClass: 'text-lightGreen border-b-2 border-y-lightGreen',
                        hoverClass: 'hover:text-lightGreen hover:border-b-2 hover:border-y-lightGreen/50',
                        badgeActive: 'bg-lightGreen text-white',
                        badgeHover: 'group-hover:bg-lightGreen group-hover:text-white',
                    },
                    Banned: {
                        label: 'banned',
                        count: this.userCounts.banned,
                        activeClass: 'text-red-400 border-b-2 border-y-red-400',
                        hoverClass: 'hover:text-red-400 hover:border-b-2 hover:border-y-red-400',
                        badgeActive: 'bg-red-400 text-white',
                        badgeHover: 'group-hover:bg-red-400 group-hover:text-white',
                    },
                } %}

                {% for value, tab in tabs %}
                    <button type="button"
                            data-action="live#action"
                            data-live-action-param="changeFilter"
                            data-live-filter-param="{{ value }}"
                            class="flex flex-row group transition-all duration-100 {{ tab.hoverClass }} {{ filter == value ? tab.activeClass : '' }}">
                        <h1 class="px-2">{{ tab.label|trans({}, 'dashboard') }}</h1>
                        <div class="w-auto h-6 mb-1 px-2 bg-veryLightGreen rounded-md text-center transition-all duration-100 {{ tab.badgeHover }} {{ filter == value ? tab.badgeActive : '' }}">
                            {{ tab.count }}
                        </div>
                    </button>
                {% endfor %}
            </div>

            {# Middle Search Bar #}
            <div class="w-full md:w-3/6">
                <div class="flex flex-row items-center border rounded-md">
                    <button type="button">
                        <svg class="w-5 mx-3 text-gray-400" fill="none" stroke="currentColor"
                             stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                        </svg>
                    </button>
                    <label class="w-full">
                        <input type="text"
                               class="form-widget w-full p-2 bg-transparent border-none outline-none"
                               placeholder="{{ 'searchUsers'|trans({}, 'dashboard') }}"
                               data-model="debounce(300)|query"
                               autocomplete="off" />
                    </label>
                </div>
            </div>

            {# Right Button #}
            {% if this.exportUsers == constant('App\\Enum\\OperationMode::ON').value %}
                <div class="flex items-center space-x-6">
                    <a href="{{ path('admin_dashboard_users_export') }}" class="btn-primary px-4 min-w-[150px]">
                        {{ 'exportEverything'|trans({}, 'dashboard') }}
                    </a>
                </div>
            {% endif %}

        </div>
    </div>

    {# Table #}
    <div class="overflow-x-auto max-w-full mt-3">
        <table class="w-full items-start">
            <thead class="text-sm text-gray-700 bg-veryLightGreen">
            <tr>
                <th scope="col" class="flex items-center p-4 pl-8">
                    <h1 class="mr-2">UUID</h1>
                    <button type="button"
                            data-action="live#action"
                            data-live-action-param="changeSort"
                            data-live-field-param="uuid"
                            class="p-1 hover:shadow-md rounded-lg cursor-pointer">
                        {{ sharedSort.sortArrow('uuid', sort, order) }}
                    </button>
                </th>
                <th scope="col" class="p-4">Email</th>
                <th scope="col" class="px-6 py-3">{{ 'provider'|trans({}, 'dashboard') }}</th>
                <th scope="col" class="px-6 py-3">{{ 'verification'|trans({}, 'dashboard') }}</th>
                <th scope="col" class="px-6 py-3">{{ '2FAStatus'|trans({}, 'dashboard') }}</th>
                <th scope="col" class="px-6 py-3">{{ 'bannedAt'|trans({}, 'dashboard') }}</th>
                <th scope="col" class="flex items-center px-6 py-3">
                    <h1 class="mr-2">{{ 'createdAt'|trans({}, 'dashboard') }}</h1>
                    <button type="button"
                            data-action="live#action"
                            data-live-action-param="changeSort"
                            data-live-field-param="createdAt"
                            class="p-1 hover:shadow-md rounded-lg cursor-pointer">
                        {{ sharedSort.sortArrow('createdAt', sort, order) }}
                    </button>
                </th>
                <th scope="col" class="px-6 py-3"><span class="none"></span></th>
            </tr>
            </thead>
            <tbody>
            {% for user in this.users %}
                {{ include('dashboard/shared/_user.html.twig', {
                    user: user,
                    delete_users: this.deleteUsers,
                    formRevokeProfiles: this.formRevokeProfiles,
                }) }}
            {% else %}
                <tr>
                    <td colspan="8">
                        <div class="flex flex-row justify-center items-start mt-2 p-4">
                            <div class="pill-error">
                                {% if query %}
                                    {{ 'noUsersFoundWith'|trans({}, 'dashboard') }} "{{ query }}"
                                {% elseif filter == constant('App\\Enum\\UserVerificationStatus::VERIFIED').value %}
                                    {{ 'noVerifiedUsers'|trans({}, 'dashboard') }}
                                {% elseif filter == constant('App\\Enum\\UserVerificationStatus::BANNED').value %}
                                    {{ 'noBannedUsers'|trans({}, 'dashboard') }}
                                {% else %}
                                    {{ 'noUsers'|trans({}, 'dashboard') }}
                                {% endif %}
                            </div>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {# Pagination #}
    <div class="m-8">
        <hr class="w-full h-0.5 bg-gray-300/50 border-0 rounded">
        {{ include('dashboard/shared/pagination/_pagination_live.html.twig', {
            label: 'usersPerPage'|trans({}, 'dashboard'),
            occurrencies: this.users|length,
            totalPages: this.totalPages,
            page: page,
            count: count,
        }) }}
    </div>
</div>
