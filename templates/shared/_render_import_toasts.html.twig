{% set errorGroups = app.flashes('import_errors')|first %}
{% if errorGroups is iterable and errorGroups|length > 0 %}
    {% set totalErrors = 0 %}
    {% for group in errorGroups %}
        {% set totalErrors = totalErrors + group.rows|length %}
    {% endfor %}

    <div class="rounded-xl border border-red-200 bg-red-50 p-4 space-y-2">
        <div class="flex items-center gap-2 text-red-800 font-semibold">
            <twig:ux:icon name="wba:info-error" class="h-5 w-5 fill-current stroke-none" />
            {{ 'importCancelledTitle'|trans({'%count%': totalErrors}, '_render_import_toasts') }}
        </div>
        <p class="text-sm text-red-700">
            {{ 'importCancelledDescription'|trans({}, '_render_import_toasts') }}
        </p>

        {% for group in errorGroups %}
            <details class="rounded-lg border border-red-200 bg-white open:shadow-sm">
                <summary class="cursor-pointer select-none px-3 py-2 text-sm font-medium text-red-800 flex items-center justify-between">
                    <span>
                        <code class="bg-red-100 px-1.5 py-0.5 rounded text-xs">{{ group.field }}</code>
                        {{ group.message }}
                    </span>
                    <span class="ml-2 shrink-0 rounded-full bg-red-100 text-red-700 text-xs px-2 py-0.5">
                        {{ 'importRowCountBadge'|trans({'%count%': group.rows|length}, '_render_import_toasts') }}
                    </span>
                </summary>
                <ul class="px-3 pb-2 pt-1 text-sm text-gray-600 divide-y divide-gray-100">
                    {% for r in group.rows|slice(0, 25) %}
                        <li class="py-1">
                            {{ 'importRowLabel'|trans({'%row%': r.row, '%name%': r.name}, '_render_import_toasts') }}
                        </li>
                    {% endfor %}
                    {% if group.rows|length > 25 %}
                        <li class="py-1 text-gray-400 italic">
                            {{ 'importMoreRows'|trans({'%count%': group.rows|length - 25}, '_render_import_toasts') }}
                        </li>
                    {% endif %}
                </ul>
            </details>
        {% endfor %}
    </div>
{% endif %}
