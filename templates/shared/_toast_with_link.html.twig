<div
        {{ stimulus_controller('toast') }}
        {{ stimulus_target('toast', 'toast') }}
        class="overflow-hidden transition-all duration-300 ease-in-out"
        style="max-height: 0; opacity: 0;"
>
    <div class="{{ toast_type }} flex-col sm:flex-row sm:items-center gap-2">
        {# Top row: icon + message #}
        <div class="flex items-start gap-3 flex-1">
            <twig:ux:icon name="{{ icon ?? 'wba:info' }}" class="w-5 h-5 fill-current shrink-0 mt-0.5"/>
            <span class="font-medium flex-1">{{ message }}</span>
        </div>

        {# Bottom row on mobile, right side on desktop: actions #}
        <div class="flex items-center gap-2 self-end sm:self-auto">

            {# Action button — optional #}
            {% if action_route is defined and action_route is not empty %}
                <a href="{{ path(action_route) }}"
                   class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg
                          text-xs font-semibold
                          bg-white text-gray-700 border border-gray-200
                          hover:bg-gray-50 transition shrink-0">
                    <twig:ux:icon name="{{ action_icon ?? 'wba:shield-check' }}" class="w-3.5 h-3.5"/>
                    <span>{{ action_label ?? 'View' }}</span>
                </a>
            {% endif %}

            {# Close button #}
            <button {{ stimulus_action('toast', 'close') }}
                    class="flex-shrink-0 opacity-60 hover:opacity-100 transition-opacity">
                <twig:ux:icon name="wba:cross-circle-rounded" class="w-4 h-4 fill-current"/>
            </button>
        </div>
    </div>
</div>
