{% extends '/dashboard/base.html.twig' %}
{% block title %}Admin Page WBA{% endblock %}

{% block container %}
    {{ include('dashboard/shared/_user_header.html.twig', {
        user: user,
        showStatus: false,
        backUrl: path('admin_dashboard_user_show', {id: user.id}),
        actions: '',
    }) }}

    <h1 class="text-2xl font-semibold mt-6 mb-6">{{ 'resetPassword'|trans({}, 'edit') }}</h1>

    {{ form_start(formReset) }}
    {{ form_errors(formReset) }}

    <div class="p-6 bg-white">
        <div class="mx-auto rounded-lg grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="relative">
                {{ form_label(formReset.password, 'password'|trans({}, 'edit'), {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(formReset.password, {attr: {class: 'form-widget'}}) }}
                <div class="mt-2 -mb-2 text-center text-red-500 text-base">
                    {{ form_errors(formReset.password) }}
                </div>
            </div>
            <div class="relative">
                {{ form_label(formReset.confirmPassword, 'confirmNewPassword'|trans({}, 'edit'), {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(formReset.confirmPassword, {attr: {class: 'form-widget'}}) }}
                <div class="mt-2 -mb-2 text-center text-red-500 text-base">
                    {{ form_errors(formReset.confirmPassword) }}
                </div>
            </div>
        </div>
        <div class="flex justify-end">
            <button type="submit"
                    class="btn-primary mt-6"
                    onclick="return confirm('{{ 'resetPasswordMessage'|trans({}, 'edit')|e('js') }}')">
                {{ 'resetPassword'|trans({}, 'edit') }}
            </button>
        </div>
    </div>

    {{ form_rest(formReset) }}
    {{ form_end(formReset) }}
{% endblock %}
