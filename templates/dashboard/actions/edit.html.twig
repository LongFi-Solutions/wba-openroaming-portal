{% extends '/dashboard/base.html.twig' %}

{% block title %}Admin Page WBA{% endblock %}

{% block container %}
    {# Content - Edit Users #}
    {# ── Header ──────────────────────────────────────────────────────────────── #}
    {% set isAdmin = isEditingSelf ? false : (
        'ROLE_ADMIN' in user.roles or 'ROLE_SUPER_ADMIN' in user.roles
        ) %}

    {% set canEdit = isAdmin
        ? is_granted(constant('App\\Security\\Voter\\UserAuthenticationVoter::ADMIN_MANAGEMENT_WRITE'))
        : is_granted(constant('App\\Security\\Voter\\UserAuthenticationVoter::USERS_MANAGEMENT_WRITE')) %}

    {{ include('dashboard/shared/_user_header.html.twig', {
        user: user,
        showStatus: false,
        backUrl: path('admin_dashboard_user_show', {id: user.id}),
        actions: canEdit
        ? '<a href="' ~ path('admin_dashboard_user_edit', {id: user.id}) ~ '" class="btn-primary text-sm">' ~ 'edit'|trans({}, 'edit') ~ '</a>'
        : '',
    }) }}

    <twig:UserUpdateForm
            :userUpdateDTO="userUpdateDTO"
            :form="form"
            :editedUser="user"
            :isEditingSelf="isEditingSelf">

        {{ form_start(form) }}
        {{ form_errors(form) }}

        <div class="p-6 bg-white">
            <div class="mx-auto rounded-lg grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div class="relative" data-controller="card">
                    <div class="flex items-center justify-between">
                        {{ form_label(form.uuid, 'uniqueIdentifier'|trans({}, 'edit'), {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(form.uuid, {attr: {class: 'form-widget'}}) }}
                        <img class="w-6 h-6 cursor-pointer ml-4"
                                {{ stimulus_target('card', 'button') }}
                                {{ stimulus_action('card', 'show_info', 'mouseover')|stimulus_action('card', 'hide_info', 'mouseout') }}
                             src="{{ asset('resources/logos/info_icon.svg') }}"
                             alt="Info icon"/>
                    </div>
                    {{ include('dashboard/shared/settings_actions/_description.html.twig', {
                        description: 'UUIDDescription'|trans({}, 'edit'),
                    }) }}
                    <div class="text-red-500 mt-1">
                        {{ form_errors(form.uuid) }}
                    </div>
                </div>

                <div class="relative">
                    {{ form_label(form.firstName, 'firstName'|trans({}, 'edit'), {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.firstName, {attr: {class: 'form-widget'}}) }}
                    <div class="text-red-500 m-2">
                        {{ form_errors(form.firstName) }}
                    </div>
                </div>

                {% if editedUser.userExternalAuths[0].provider == constant('App\\Enum\\UserProvider::PORTAL_ACCOUNT').value %}
                    {% if editedUser.userExternalAuths[0].providerId == constant('App\\Enum\\UserProvider::EMAIL').value %}
                        {# Email #}
                        <div class="relative">
                            {{ form_label(form.email, 'Email', {label_attr: {class: 'form-label'}}) }}
                            {{ form_widget(form.email, {attr: {class: 'form-widget'}}) }}
                            <div class="text-red-500 m-2">
                                {{ form_errors(form.email) }}
                            </div>
                        </div>
                    {% elseif editedUser.userExternalAuths[0].providerId == constant('App\\Enum\\UserProvider::PHONE_NUMBER').value %}
                        {# Phone Number #}
                        <div class="relative">
                            <div class="flex flex-row items-end space-x-4">
                                {# Phone Number Input #}
                                <div class="flex flex-col w-1/3">
                                    {{ form_label(form.phoneNumber, 'phoneNumber'|trans({}, 'edit'), {label_attr: {class: 'form-label'}}) }}
                                    {{ form_widget(form.phoneNumber.children.country, {
                                        attr: {
                                            class: 'form-widget',
                                            placeholder: 'phoneNumberPlaceOlder'|trans({}, 'edit'),
                                            autocomplete: 'tel',
                                        },
                                    }) }}
                                </div>
                                <div class="flex flex-col w-2/3">
                                    {{ form_widget(form.phoneNumber.children.number, {
                                        attr: {
                                            class: 'form-widget',
                                            placeholder: 'phoneNumberPlaceOlder'|trans({}, 'edit'),
                                            autocomplete: 'tel',
                                        },
                                    }) }}
                                </div>
                            </div>

                            <div class="text-red-500 m-2">
                                {{ form_errors(form.phoneNumber) }}
                            </div>
                        </div>
                    {% endif %}
                {% else %}
                    {# Email #}
                    <div class="relative">
                        {{ form_label(form.email, 'Email', {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(form.email, {attr: {class: 'form-widget'}}) }}
                        <div class="text-red-500 m-2">
                            {{ form_errors(form.email) }}
                        </div>
                    </div>
                {% endif %}

                <div class="relative">
                    {{ form_label(form.lastName, 'lastName'|trans({}, 'edit'), {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.lastName, {attr: {class: 'form-widget'}}) }}
                    <div class="text-red-500 m-2">
                        {{ form_errors(form.lastName) }}
                    </div>
                </div>

                <div class="w-full lg:w-1/2">
                    <div class="flex md:flex-row flex-col items-center sm:justify-start">
                        {% if form.isVerified is defined %}

                            <div class="flex flex-col mx-4 space-x-3 space-y-2">
                                <p class="font-bold">{{ 'verification'|trans({}, 'edit') }}</p>
                                <label class="inline-flex items-center cursor-pointer">
                                    {{ form_widget(form.isVerified, {attr: {class: 'sr-only peer'}}) }}
                                    <div class="ms-2 relative w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-bg-lightGreen rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#68D391]"></div>
                                    {{ form_errors(form.isVerified) }}
                                </label>
                            </div>
                        {% endif %}
                        {% if form.banned is defined %}
                            <div class="flex flex-col mt-2 md:mt-0 mx-4 space-y-2">
                                <p class="font-bold">{{ 'banned'|trans({}, 'edit') }}</p>
                                <label class="inline-flex items-center cursor-pointer">
                                    {{ form_widget(form.banned, {attr: {class: 'sr-only peer'}}) }}
                                    <div class="ms-2 relative w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-bg-lightGreen rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#f87171]"></div>
                                    {{ form_errors(form.banned) }}
                                </label>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            {% if is_granted(constant('App\\Security\\Voter\\UserAuthenticationVoter::ADMIN_MANAGEMENT_WRITE')) and
                userUpdateDTO.editingAdmin %}
                {# Permissions Section #}
                <div class="mt-4 lg:col-span-2 flex flex-col gap-4">
                    {% if not isEditingSelf %}
                        <h2 class="text-xl sm:text-2xl font-semibold text-gray-800">
                            {{ 'editPermissions'|trans({}, 'UserUpdateType') }}
                        </h2>

                        <div class="flex flex-col gap-6">
                            {{ include('dashboard/shared/_page_permissions.html.twig') }}
                        </div>
                    {% endif %}
                </div>
            {% endif %}

            {% if is_granted(constant('App\\Security\\Voter\\UserAuthenticationVoter::USERS_MANAGEMENT_WRITE')) %}
                <div class="flex flex-row justify-end md:w-full mt-6">
                    <button type="submit" class="btn-primary">{{ 'applyChanges'|trans({}, 'edit') }}</button>
                </div>
            {% endif %}
        </div>

        {{ form_rest(form) }}
        {{ form_end(form) }}
    </twig:UserUpdateForm>
{% endblock %}
