{% extends '/dashboard/base.html.twig' %}
{% block title %}{{ user.uuid }}{% endblock %}

{% block container %}

    {# ── Header ─────────────────────────────────────────────────────────────── #}
    <div class="flex items-center justify-between mb-8 border-b-2 border-gray-300 pb-4">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-full bg-veryDarkButton text-white flex items-center justify-center text-2xl font-bold">
                {{ user.firstName|first|upper }}{{ user.lastName|first|upper }}
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-800">
                    {{ user.firstName }} {{ user.lastName }}
                </h1>
                <p class="text-sm text-gray-400 font-mono">{{ user.uuid }}</p>
            </div>
        </div>
        <div class="flex gap-2">
            {% if user.banned %}
                <span class="pill-error">{{ 'banned'|trans({}, 'show') }}</span>
            {% endif %}
            {% if user.isVerified %}
                <span class="pill-success">{{ 'verified'|trans({}, 'show') }}</span>
            {% else %}
                <span class="pill-warning">{{ 'unverified'|trans({}, 'show') }}</span>
            {% endif %}
            <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="btn-primary text-sm">
                {{ 'edit'|trans({}, 'edit') }}
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        {# ── Left column ─────────────────────────────────────────────────────── #}
        <div class="lg:col-span-1 flex flex-col gap-6">

            {# Basic info #}
            <div class="bg-white rounded-xl shadow-sm p-6">
                <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">
                    {{ 'basicInfo'|trans({}, 'show') }}
                </h2>
                <dl class="space-y-3 text-sm">
                    <div class="flex justify-between">
                        <dt class="text-gray-500">{{ 'firstName'|trans({}, 'edit') }}</dt>
                        <dd class="font-medium text-gray-800">{{ user.firstName ?: '—' }}</dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-gray-500">{{ 'lastName'|trans({}, 'edit') }}</dt>
                        <dd class="font-medium text-gray-800">{{ user.lastName ?: '—' }}</dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-gray-500">Email</dt>
                        <dd class="font-medium text-gray-800 truncate max-w-[180px]">{{ user.email ?: '—' }}</dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-gray-500">{{ 'createdAt'|trans({}, 'dashboard') }}</dt>
                        <dd class="font-medium text-gray-800">{{ user.createdAt|date('d/m/Y') }}</dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-gray-500">2FA</dt>
                        <dd class="font-medium text-gray-800">{{ user.twoFAtype ?: 'Disabled' }}</dd>
                    </div>
                </dl>
            </div>

            {# Auth providers #}
            <div class="bg-white rounded-xl shadow-sm p-6">
                <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">
                    {{ 'authProviders'|trans({}, 'edit') }}
                </h2>
                {% for auth in externalAuths %}
                    <div class="flex items-center justify-between py-2 border-b border-gray-100 last:border-0 text-sm">
                        <span class="text-gray-600">{{ auth.provider }}</span>
                        <span class="font-mono text-xs text-gray-400 truncate max-w-[140px]">{{ auth.providerId }}</span>
                    </div>
                {% else %}
                    <p class="text-sm text-gray-400">—</p>
                {% endfor %}
            </div>

            {# Connection status #}
            {% if lastAccounting %}
                <div class="bg-white rounded-xl shadow-sm p-6">
                    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">
                        {{ 'profileConnectionStatus'|trans({}, 'edit') }}
                    </h2>
                    <dl class="space-y-3 text-sm">
                        <div class="flex justify-between">
                            <dt class="text-gray-500">{{ 'lastStartConnection'|trans({}, 'edit') }}</dt>
                            <dd class="font-medium text-gray-800">
                                {{ lastAccounting.acctstarttime|date('d/m/Y H:i') }} UTC
                            </dd>
                        </div>
                        {% if lastAccounting.acctstoptime %}
                            <div class="flex justify-between">
                                <dt class="text-gray-500">{{ 'lastStopConnection'|trans({}, 'edit') }}</dt>
                                <dd class="font-medium text-gray-800">
                                    {{ lastAccounting.acctstoptime|date('d/m/Y H:i') }} UTC
                                </dd>
                            </div>
                        {% endif %}
                        {% if lastAccounting.framedipaddress %}
                            <div class="flex justify-between">
                                <dt class="text-gray-500">IP</dt>
                                <dd class="font-mono text-xs text-gray-800">{{ lastAccounting.framedipaddress }}</dd>
                            </div>
                        {% endif %}
                    </dl>
                </div>
            {% endif %}

        </div>

        {# ── Right column ─────────────────────────────────────────────────────── #}
        <div class="lg:col-span-2 flex flex-col gap-6">

            {# RADIUS profiles #}
            <div class="bg-white rounded-xl shadow-sm p-6">
                <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">
                    {{ 'radiusProfiles'|trans({}, 'edit') }}
                </h2>
                {% if radiusProfiles is not empty %}
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead class="bg-veryLightGreen text-gray-600">
                            <tr>
                                <th class="px-4 py-2 text-left">{{ 'profile'|trans({}, 'edit') }}</th>
                                <th class="px-4 py-2 text-left">Status</th>
                                <th class="px-4 py-2 text-left">{{ 'createdAt'|trans({}, 'dashboard') }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for profile in radiusProfiles %}
                                <tr class="border-b border-gray-100 hover:bg-gray-50">
                                    <td class="px-4 py-2 font-mono text-xs">{{ profile.radiusUser }}</td>
                                    <td class="px-4 py-2">
                                        {% if profile.status %}
                                            <span class="pill-success text-xs">Active</span>
                                        {% else %}
                                            <span class="pill-error text-xs">Inactive</span>
                                        {% endif %}
                                    </td>
                                    <td class="px-4 py-2 text-gray-500">{{ profile.createdAt|date('d/m/Y') }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-sm text-gray-400">—</p>
                {% endif %}
            </div>

            {# Certificates #}
            <div class="bg-white rounded-xl shadow-sm p-6">
                <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">
                    {{ 'certificates'|trans({}, 'edit') }}
                </h2>
                {% if certificates is not empty %}
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead class="bg-veryLightGreen text-gray-600">
                            <tr>
                                <th class="px-4 py-2 text-left">Type</th>
                                <th class="px-4 py-2 text-left">{{ 'createdAt'|trans({}, 'dashboard') }}</th>
                                <th class="px-4 py-2 text-left">Status</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for cert in certificates %}
                                <tr class="border-b border-gray-100 hover:bg-gray-50">
                                    <td class="px-4 py-2">{{ cert.type }}</td>
                                    <td class="px-4 py-2 text-gray-500">{{ cert.createdAt|date('d/m/Y') }}</td>
                                    <td class="px-4 py-2">
                                        <span class="pill-success text-xs">{{ cert.status }}</span>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-sm text-gray-400">—</p>
                {% endif %}
            </div>

            {# Recent activity — placeholder for the live component you'll add later #}
            <div class="bg-white rounded-xl shadow-sm p-6">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">
                        {{ 'recentActivity'|trans({}, 'dashboard') }}
                    </h2>
                    <a href="{{ path('admin_activity_logs', {search: user.uuid}) }}"
                       class="text-xs text-veryDarkButton hover:underline">
                        {{ 'viewAll'|trans({}, 'dashboard') }} →
                    </a>
                </div>
                <div class="space-y-2">
                    {% for event in recentEvents|slice(0, 8) %}
                        <div class="flex items-center justify-between py-2 border-b border-gray-100 last:border-0 text-sm">
                            <span class="text-gray-700">{{ event.eventName }}</span>
                            <span class="text-xs text-gray-400">{{ event.eventDatetime|date('d/m/Y H:i') }}</span>
                        </div>
                    {% else %}
                        <p class="text-sm text-gray-400">—</p>
                    {% endfor %}
                </div>
            </div>

        </div>
    </div>

{% endblock %}
