{% extends '/dashboard/base.html.twig' %}
{% block title %}Admin Page WBA{% endblock %}

{% block container %}

    {# ── Header ──────────────────────────────────────────────────────────────── #}
    {% set canEdit = isAdmin
        ? is_granted(constant('App\\Security\\Voter\\UserAuthenticationVoter::ADMIN_MANAGEMENT_WRITE'))
        : is_granted(constant('App\\Security\\Voter\\UserAuthenticationVoter::USERS_MANAGEMENT_WRITE')) %}

    {{ include('dashboard/shared/_user_header.html.twig', {
        user: userData.user,
        showStatus: true,
        isAdmin: isAdmin,
        actions: canEdit
        ? '<a href="' ~ path('admin_dashboard_user_edit', {id: userData.user.id}) ~ '" class="btn-primary text-sm">' ~ 'edit'|trans({}, 'edit') ~ '</a>'
        : ''
    }) }}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">

        {# ── Left column ──────────────────────────────────────────────────────────── #}
        <div class="lg:col-span-1 flex flex-col gap-6">

            {# Basic info #}
            <div class="bg-white rounded-xl shadow-sm p-6">
                <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">
                    {{ 'basicInfo'|trans({}, 'show') }}
                </h2>
                <dl class="space-y-3 text-sm">
                    <div class="flex justify-between gap-2">
                        <dt class="text-gray-500 shrink-0">{{ 'firstName'|trans({}, 'edit') }}</dt>
                        <dd class="font-medium text-gray-800 text-right">{{ userData.user.firstName ?: '—' }}</dd>
                    </div>
                    <div class="flex justify-between gap-2">
                        <dt class="text-gray-500 shrink-0">{{ 'lastName'|trans({}, 'edit') }}</dt>
                        <dd class="font-medium text-gray-800 text-right">{{ userData.user.lastName ?: '—' }}</dd>
                    </div>
                    <div class="flex justify-between gap-2">
                        <dt class="text-gray-500 shrink-0">Email</dt>
                        <dd class="font-medium text-gray-800 truncate max-w-[180px] text-right">
                            {{ userData.user.email ?: '—' }}
                        </dd>
                    </div>
                    {% if userData.user.phoneNumber %}
                        <div class="flex justify-between gap-2">
                            <dt class="text-gray-500 shrink-0">{{ 'phoneNumber'|trans({}, 'edit') }}</dt>
                            <dd class="font-medium text-gray-800 text-right font-mono text-xs">
                                {{ userData.user.phoneNumber }}
                            </dd>
                        </div>
                    {% endif %}
                    <div class="flex justify-between gap-2">
                        <dt class="text-gray-500 shrink-0">{{ 'createdAt'|trans({}, 'dashboard') }}</dt>
                        <dd class="font-medium text-gray-800 text-right">
                            {{ userData.user.createdAt|date('d/m/Y H:i') }}
                        </dd>
                    </div>
                    {% if userData.isBanned and userData.user.bannedAt %}
                        <div class="flex justify-between gap-2">
                            <dt class="text-gray-500 shrink-0">{{ 'bannedAt'|trans({}, 'show') }}</dt>
                            <dd class="font-medium text-red-500 text-right">
                                {{ userData.user.bannedAt|date('d/m/Y H:i') }}
                            </dd>
                        </div>
                    {% endif %}
                    <div class="flex justify-between gap-2">
                        <dt class="text-gray-500 shrink-0">2FA</dt>
                        {{ include('dashboard/shared/_2fa_badge.html.twig', { twoFAtype: userData.user.twoFAtype }) }}
                    </div>
                </dl>
            </div>

            {# Auth providers #}
            <div class="bg-white rounded-xl shadow-sm p-6">
                <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">
                    {{ 'authProviders'|trans({}, 'show') }}
                </h2>
                {% for auth in userData.externalAuths %}
                    <div class="flex items-center justify-between py-2 border-b border-gray-100 last:border-0 text-sm gap-2">
                        <span class="text-gray-600 shrink-0">{{ auth.provider }}</span>
                        <span class="font-mono text-xs text-gray-400 truncate">{{ auth.providerId }}</span>
                    </div>
                {% else %}
                    <p class="text-sm text-gray-400">—</p>
                {% endfor %}
            </div>

            {# Last connection #}
            {% if userData.lastAccounting %}
                <div class="bg-white rounded-xl shadow-sm p-6">
                    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">
                        {{ 'profileConnectionStatus'|trans({}, 'edit') }}
                    </h2>
                    <dl class="space-y-3 text-sm">
                        {% if userData.lastAccounting.acctStartTime %}
                            <div class="flex justify-between gap-2">
                                <dt class="text-gray-500 shrink-0">{{ 'lastStartConnection'|trans({}, 'edit') }}</dt>
                                <dd class="font-medium text-gray-800 text-right">
                                    {{ userData.lastAccounting.acctStartTime|date('d/m/Y H:i') }} UTC
                                </dd>
                            </div>
                        {% endif %}
                        {% if userData.lastAccounting.acctStopTime %}
                            <div class="flex justify-between gap-2">
                                <dt class="text-gray-500 shrink-0">{{ 'lastStopConnection'|trans({}, 'edit') }}</dt>
                                <dd class="font-medium text-gray-800 text-right">
                                    {{ userData.lastAccounting.acctStopTime|date('d/m/Y H:i') }} UTC
                                </dd>
                            </div>
                        {% endif %}
                        {% if userData.lastAccounting.framedIpAddress %}
                            <div class="flex justify-between gap-2">
                                <dt class="text-gray-500 shrink-0">IP</dt>
                                <dd class="font-mono text-xs text-gray-800 text-right">
                                    {{ userData.lastAccounting.framedIpAddress }}
                                </dd>
                            </div>
                        {% endif %}
                        {% if userData.lastAccounting.acctSessionTime %}
                            <div class="flex justify-between gap-2">
                                <dt class="text-gray-500 shrink-0">{{ 'sessionDuration'|trans({}, 'show') }}</dt>
                                <dd class="font-medium text-gray-800 text-right">
                                    {{ (userData.lastAccounting.acctSessionTime / 60)|round(0, 'floor') }} min
                                </dd>
                            </div>
                        {% endif %}
                        {% if userData.lastAccounting.realm %}
                            <div class="flex justify-between gap-2">
                                <dt class="text-gray-500 shrink-0">Realm</dt>
                                <dd class="font-mono text-xs text-gray-800 text-right truncate max-w-[160px]">
                                    {{ userData.lastAccounting.realm }}
                                </dd>
                            </div>
                        {% endif %}
                    </dl>
                </div>
            {% endif %}

            {# Last RADIUS auth #}
            {% if userData.lastAuth %}
                <div class="bg-white rounded-xl shadow-sm p-6">
                    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">
                        {{ 'lastAuth'|trans({}, 'show') }}
                    </h2>
                    <dl class="space-y-3 text-sm">
                        <div class="flex justify-between gap-2">
                            <dt class="text-gray-500 shrink-0">{{ 'date'|trans({}, 'show') }}</dt>
                            <dd class="font-medium text-gray-800 text-right">
                                {{ userData.lastAuth.authdate|date('d/m/Y H:i') }} UTC
                            </dd>
                        </div>
                        <div class="flex justify-between gap-2">
                            <dt class="text-gray-500 shrink-0">Reply</dt>
                            <dd class="text-right">
                                {% if userData.lastAuth.reply == 'Access-Accept' %}
                                    <span class="pill-success text-xs">{{ userData.lastAuth.reply }}</span>
                                {% else %}
                                    <span class="pill-error text-xs">{{ userData.lastAuth.reply }}</span>
                                {% endif %}
                            </dd>
                        </div>
                    </dl>
                </div>
            {% endif %}

            {# Content - Two-Factor Options #}
            {% if app.user and userData.user.id == app.user.id %}
                {% if userData.user.twoFAtype != constant('App\\Enum\\UserTwoFactorAuthenticationStatus::DISABLED').value %}
                    <div class="bg-white rounded-xl shadow-sm p-6">
                        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">
                            {{ 'TwoFAOptions'|trans({}, 'edit') }}
                        </h2>
                        <div class="flex flex-col gap-3">
                            <a href="{{ path('app_configure2FA', {context: context}) }}"
                               class="btn-secondary w-full text-center">
                                {{ 'configureTwoFactorAuthentication'|trans({}, 'edit') }}
                            </a>
                            <a href="{{ path('app_disable2FA', {context: context}) }}"
                               class="btn-logout w-full text-center">
                                {{ 'disable'|trans({}, 'edit') }}
                            </a>
                        </div>
                    </div>
                {% endif %}
            {% else %}
                {% set can2FA = userData.isAdmin
                    ? is_granted(constant('App\\Security\\Voter\\UserAuthenticationVoter::ADMIN_MANAGEMENT_WRITE'))
                    : is_granted(constant('App\\Security\\Voter\\UserAuthenticationVoter::USERS_MANAGEMENT_WRITE')) %}

                {% if can2FA and userData.user.twoFAtype != constant('App\\Enum\\UserTwoFactorAuthenticationStatus::DISABLED').value %}
                    <div class="bg-white rounded-xl shadow-sm p-6">
                        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">
                            {{ 'TwoFAOptions'|trans({}, 'edit') }}
                        </h2>
                        <a href="{{ path('admin_dashboard_user_disable2FA', {id: userData.user.id}) }}"
                           class="btn-logout w-full text-center block"
                           data-confirm="{{ 'disable2FAMessage'|trans({}, 'edit')|e('html_attr') }}">
                            {{ 'disable'|trans({}, 'edit') }}
                        </a>
                    </div>
                {% endif %}
            {% endif %}

        </div>

        {# ── Right column ─────────────────────────────────────────────────────────── #}
        <div class="lg:col-span-2 flex flex-col gap-6">

            {# RADIUS profiles #}
            <div class="bg-white rounded-xl shadow-sm p-6">
                <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">
                    {{ 'radiusProfiles'|trans({}, 'show') }}
                </h2>
                {% if userData.radiusProfiles is not empty %}
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead class="bg-veryLightGreen text-gray-600">
                            <tr>
                                <th class="px-4 py-2 text-left">{{ 'profile'|trans({}, 'show') }}</th>
                                <th class="px-4 py-2 text-left">Status</th>
                                <th class="px-4 py-2 text-left">{{ 'issuedAt'|trans({}, 'show') }}</th>
                                <th class="px-4 py-2 text-left">{{ 'validUntil'|trans({}, 'show') }}</th>
                                <th class="px-4 py-2 text-left">{{ 'lastConnection'|trans({}, 'show') }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for profile in userData.radiusProfiles %}
                                <tr class="border-b border-gray-100 hover:bg-gray-50">
                                    <td class="px-4 py-2 font-mono text-xs">{{ profile.radiusUser }}</td>
                                    <td class="px-4 py-2">
                                        {% if profile.status == 1 %}
                                            <span class="pill-success text-xs">{{ 'active'|trans({}, 'show') }}</span>
                                        {% else %}
                                            <span class="pill-error text-xs">
                                        {{ profile.revokedReason ?: 'inactive'|trans({}, 'show') }}
                                    </span>
                                        {% endif %}
                                    </td>
                                    <td class="px-4 py-2 text-gray-500 text-xs">
                                        {{ profile.issuedAt|date('d/m/Y H:i') }}
                                    </td>
                                    <td class="px-4 py-2 text-gray-500 text-xs">
                                        {{ profile.validUntil ? profile.validUntil|date('d/m/Y H:i') : '—' }}
                                    </td>
                                    <td class="px-4 py-2 text-gray-500 text-xs">
                                        {{ profile.lastConnectionStartAt ? profile.lastConnectionStartAt|date('d/m/Y H:i') : '—' }}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-sm text-gray-400">—</p>
                {% endif %}
            </div>

            {# Recent Radius Sessions #}
            {% if userData.recentSessions is not empty %}
                <div class="bg-white rounded-xl shadow-sm p-6">
                    <div class="px-6 pt-5 pb-2 border-b border-gray-100">
                        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">
                            {{ 'recentSessions'|trans({}, 'show') }}
                        </h2>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead class="bg-veryLightGreen text-gray-600">
                            <tr>
                                <th class="px-4 py-2 text-left">{{ 'start'|trans({}, 'show') }}</th>
                                <th class="px-4 py-2 text-left">{{ 'stop'|trans({}, 'show') }}</th>
                                <th class="px-4 py-2 text-left">IP</th>
                                <th class="px-4 py-2 text-left">{{ 'duration'|trans({}, 'show') }}</th>
                                <th class="px-4 py-2 text-left">Realm</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for session in userData.recentSessions %}
                                <tr class="border-b border-gray-100 hover:bg-gray-50 text-xs">
                                    <td class="px-4 py-2 text-gray-700">
                                        {{ session.acctStartTime ? session.acctStartTime|date('d/m/Y H:i') : '—' }}
                                    </td>
                                    <td class="px-4 py-2 text-gray-500">
                                        {{ session.acctStopTime ? session.acctStopTime|date('d/m/Y H:i') : '—' }}
                                    </td>
                                    <td class="px-4 py-2 font-mono text-gray-700">
                                        {{ session.framedIpAddress ?: '—' }}
                                    </td>
                                    <td class="px-4 py-2 text-gray-500">
                                        {% if session.acctSessionTime %}
                                            {{ (session.acctSessionTime / 60)|round(0, 'floor') }} min
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td class="px-4 py-2 text-gray-500 truncate max-w-[120px]">
                                        {{ session.realm ?: '—' }}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endif %}


            {# ── Activity logs — full width below ── #}
            <div class="bg-white rounded-xl shadow-sm overflow-hidden">
                <div class="px-6 pt-5 pb-2 gray-100">
                    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">
                        {{ 'recentActivity'|trans({}, 'show') }}
                    </h2>
                </div>
                <twig:ActivityLogSearchForm
                        :user="userData.user"
                        query=""
                        filter="all"
                        page="1"
                        count="10"
                />
            </div>
        </div>
    </div>

{% endblock %}
