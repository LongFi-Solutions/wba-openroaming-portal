<div class="flex flex-col sm:flex-row items-center justify-start mt-5 gap-y-6">

    {# Per page selector #}
    <div class="flex flex-row justify-start items-center gap-4 text-sm">
        <label>{{ label }}</label>
        <select class="form-select"
                data-model="count"
                data-action="change->live#update">
            <option value="7" {% if count == 7 %}selected{% endif %}>7</option>
            <option value="10" {% if count == 10 %}selected{% endif %}>10</option>
            <option value="20" {% if count == 20 %}selected{% endif %}>20</option>
            <option value="50" {% if count == 50 %}selected{% endif %}>50</option>
            <option value="100" {% if count == 100 %}selected{% endif %}>100</option>
        </select>
    </div>

    {% if totalPages > 1 %}
        <div class="sm:ml-auto flex flex-row text-base cursor-default">

            {# Range display #}
            <div class="flex space-x-2 mr-4 text-sm text-gray-500">
                {{ (page - 1) * count + 1 }} - {{ min(page * count, occurrencies) }}
                of {{ occurrencies }}
            </div>

            <div class="flex space-x-2.5">

                {# First Page #}
                <button type="button"
                        {% if page > 1 %}
                            data-action="click->live#update"
                            data-model="page"
                            data-value="1"
                        {% else %}
                            disabled
                        {% endif %}
                        class="hover:shadow-md p-1 rounded-lg {{ page > 1 ? 'cursor-pointer' : 'text-gray-400 cursor-not-allowed' }}"
                        title="{{ 'firstPage'|trans({}, '_pagination') }}">
                    <twig:ux:icon name="wba:d-right" class="w-4 rotate-180 fill-none stroke-current" />
                    <span class="sr-only">{{ 'firstPage'|trans({}, '_pagination') }}</span>
                </button>

                {# Previous Page #}
                <button type="button"
                        {% if page > 1 %}
                            data-action="click->live#update"
                            data-model="page"
                            data-value="{{ page - 1 }}"
                        {% else %}
                            disabled
                        {% endif %}
                        class="hover:shadow-md p-1 rounded-lg {{ page > 1 ? 'cursor-pointer' : 'text-gray-400 cursor-not-allowed' }}"
                        title="{{ 'previousPage'|trans({}, '_pagination') }}">
                    <twig:ux:icon name="wba:right" class="w-4 rotate-180 fill-none stroke-current" />
                    <span class="sr-only">{{ 'previousPage'|trans({}, '_pagination') }}</span>
                </button>

                {# Next Page #}
                <button type="button"
                        {% if page < totalPages %}
                            data-action="click->live#update"
                            data-model="page"
                            data-value="{{ page + 1 }}"
                        {% else %}
                            disabled
                        {% endif %}
                        class="hover:shadow-md p-1 rounded-lg {{ page < totalPages ? 'cursor-pointer' : 'text-gray-400 cursor-not-allowed' }}"
                        title="{{ 'nextPage'|trans({}, '_pagination') }}">
                    <twig:ux:icon name="wba:right" class="w-4 fill-none stroke-current" />
                    <span class="sr-only">{{ 'nextPage'|trans({}, '_pagination') }}</span>
                </button>

                {# Last Page #}
                <button type="button"
                        {% if page < totalPages %}
                            data-action="click->live#update"
                            data-model="page"
                            data-value="{{ totalPages }}"
                        {% else %}
                            disabled
                        {% endif %}
                        class="hover:shadow-md p-1 rounded-lg {{ page < totalPages ? 'cursor-pointer' : 'text-gray-400 cursor-not-allowed' }}"
                        title="{{ 'lastPage'|trans({}, '_pagination') }}">
                    <twig:ux:icon name="wba:d-right" class="w-4 fill-none stroke-current" />
                    <span class="sr-only">{{ 'lastPage'|trans({}, '_pagination') }}</span>
                </button>

            </div>
        </div>
    {% endif %}
</div>
