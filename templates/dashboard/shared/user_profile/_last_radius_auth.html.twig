{# Last RADIUS auth #}
<div class="bg-white rounded-xl shadow-sm p-6">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">
        {{ 'lastAuth'|trans({}, 'show') }}
    </h2>
    {% if userData.lastAuth %}
        <dl class="space-y-3 text-sm">
            <div class="flex justify-between gap-2">
                <dt class="text-gray-500 shrink-0">{{ 'date'|trans({}, 'show') }}</dt>
                <dd class="font-medium text-gray-800 text-right">
                    {{ userData.lastAuth.authdate|date('d/m/Y H:i') }} UTC
                </dd>
            </div>
            <div class="flex justify-between gap-2">
                <dt class="text-gray-500 shrink-0">Reply</dt>
                <dd class="text-right">
                    {% if userData.lastAuth.reply == 'Access-Accept' %}
                        <span class="pill-success text-xs">{{ userData.lastAuth.reply }}</span>
                    {% else %}
                        <span class="pill-error text-xs">{{ userData.lastAuth.reply }}</span>
                    {% endif %}
                </dd>
            </div>
        </dl>
    {% else %}
        <p class="text-sm text-gray-400">—</p>
    {% endif %}
</div>