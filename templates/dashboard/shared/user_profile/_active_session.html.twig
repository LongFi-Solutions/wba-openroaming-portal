{# Currently connected #}
<div class="bg-white rounded-xl shadow-sm p-6">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">
        {{ 'connectionStatus'|trans({}, 'show') }}
    </h2>
    {% if userData.activeSession %}
        <div class="flex items-center gap-2 mb-4">
            <span class="inline-block w-2 h-2 rounded-full bg-green-400"></span>
            <span class="text-sm font-medium text-green-600">{{ 'currentlyConnected'|trans({}, 'show') }}</span>
        </div>
        <dl class="space-y-3 text-sm">
            {# Connected Since (acctStartTime) #}
            <div class="flex justify-between gap-2">
                <dt class="text-gray-500 shrink-0">{{ 'connectedSince'|trans({}, 'show') }}</dt>
                <dd class="font-medium text-gray-800 text-right">
                    {{ userData.activeSession.acctStartTime|date('d/m/Y H:i') }} UTC
                </dd>
            </div>

            {# User IP (framedIpAddress) #}
            <div class="flex justify-between gap-2">
                <dt class="text-gray-500 shrink-0">{{ 'userIp'|trans({}, 'show') }}</dt>
                <dd class="font-mono text-xs text-gray-800 text-right">
                    {{ userData.activeSession.framedIpAddress is not empty ? userData.activeSession.framedIpAddress : '—' }}
                </dd>
            </div>

            {# Access Point IP (calledStationId) #}
            <div class="flex justify-between gap-2">
                <dt class="text-gray-500 shrink-0">Access Point</dt>
                <dd class="font-mono text-xs text-gray-800 text-right max-w-[260px]">
                    {{ userData.activeSession.calledStationId is not empty ? userData.activeSession.calledStationId : '—' }}
                </dd>
            </div>

            {# Access Point IP (nasIpAddress) #}
            {% if userData.activeSession.nasIpAddress is not empty %}
                <div class="flex justify-between gap-2">
                    <dt class="text-gray-500 shrink-0">{{ 'accessPointIp'|trans({}, 'show') }}</dt>
                    <dd class="font-mono text-xs text-gray-800 text-right">{{ userData.activeSession.nasIpAddress }}</dd>
                </div>
            {% endif %}
        </dl>
    {% else %}
        <div class="flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-gray-300"></span>
            <span class="text-sm text-gray-400">{{ 'notConnected'|trans({}, 'show') }}</span>
        </div>
    {% endif %}
</div>