{# Clickable Row — triggers modal by ID #}
<tr class="border-b hover:bg-veryLightGreen transition-all duration-100 cursor-pointer"
        {{ stimulus_controller('modal-trigger', { modalId: 'log-modal-' ~ log.id }) }}
    data-action="click->modal-trigger#open">

    <td class="p-4 pl-8 font-medium">
        {% if log.user is not null %}
            {{ log.user.uuid }}
        {% else %}
            <span class="font-semibold p-1 pill-error">{{ 'noInformation'|trans({}, '_user') }}</span>
        {% endif %}
    </td>

    <td class="p-4 font-medium">
        <span class="pill-info">{{ log.eventName }}</span>
    </td>

    <td class="p-4 text-gray-500">
        {{ log.eventMetadata.ip ?? '-' }}
    </td>

    <td class="px-6 py-4 font-medium">
        {{ log.eventDatetime|date('d/m/Y H:i') }}
    </td>
</tr>
