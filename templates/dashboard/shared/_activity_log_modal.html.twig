<div id="event-modal-{{ event.id }}"
        {{ stimulus_controller('modal') }}
     data-action="click->modal#close"
     class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 opacity-0 transition-opacity duration-200">

    <div class="contents">

        <div class="absolute inset-0"></div>

        <div {{ stimulus_target('modal', 'panel') }}
                data-action="click->modal#stopPropagation"
                class="relative w-full max-w-2xl mx-4 opacity-0 scale-95 transition-all duration-200 border border-gray-200 rounded-xl shadow-sm overflow-hidden">

            {# Modal Header #}
            <div class="bg-gray-50 px-6 py-4 border-b border-gray-200 flex items-center justify-between gap-4">
                <div class="flex items-center gap-2 min-w-0">
                    <twig:ux:icon name="wba:clock-counter-clockwise" class="w-5 h-5 text-primary shrink-0"/>
                    <h5 class="text-lg font-semibold text-gray-800 truncate">{{ event.eventName }}</h5>
                </div>
                <div class="flex items-center gap-3 shrink-0">
                    <p class="text-sm text-gray-400 whitespace-nowrap">{{ event.eventDatetime|date('d/m/Y H:i:s') }}</p>
                    <button {{ stimulus_action('modal', 'close') }}
                            class="text-gray-400 hover:text-gray-600 transition">
                        <twig:ux:icon name="wba:cross-circle-rounded" class="w-5 h-5 fill-current"/>
                    </button>
                </div>
            </div>

            {# Modal Body #}
            <div class="px-6 py-5 space-y-5 bg-white">

                {# Pills row #}
                <div class="flex flex-wrap gap-2 text-sm">
                    {% if event.containsEncryptedData %}
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-50 border border-amber-200 rounded-full text-amber-700 text-xs font-medium">
                            <twig:ux:icon name="wba:lock-outline" class="w-3.5 h-3.5 shrink-0"/>
                            {{ 'encryptedEvent'|trans({}, 'dashboard') }}
                        </span>
                    {% endif %}
                    {% if showUser is not defined or showUser %}
                        {% if event.user is not null %}
                            <span class="px-3 py-1 bg-gray-50 border border-gray-200 rounded-full text-gray-700">
                                {% if event.containsEncryptedData %}
                                    <strong>UUID:</strong>  <span
                                        class="text-gray-400 italic text-sm">Deleted User ID: {{ event.user.id }}</span>
                                {% else %}
                                    <strong>UUID:</strong> {{ event.user.uuid }}
                                {% endif %}
                            </span>
                        {% endif %}
                    {% endif %}
                    {% if event.eventMetadata.by is defined %}
                        <span class="px-3 py-1 bg-gray-50 border border-gray-200 rounded-full text-gray-700">
                            <strong>By:</strong> {{ event.eventMetadata.by }}
                        </span>
                    {% endif %}
                    {% if event.eventMetadata.ip is defined %}
                        <span class="px-3 py-1 bg-gray-50 border border-gray-200 rounded-full text-gray-700">
                            <strong>IP:</strong> {{ event.eventMetadata.ip }}
                        </span>
                    {% endif %}
                </div>

                {# Errors block #}
                {% if event.eventMetadata.errors is defined and event.eventMetadata.errors is not empty %}
                    <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3">
                        <p class="text-sm font-semibold text-red-600 mb-1">Errors</p>
                        <ul class="list-disc list-inside text-sm text-red-500 space-y-1">
                            {% for error in event.eventMetadata.errors %}
                                <li>{{ error }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                {# Metadata block #}
                <div class="space-y-2" data-controller="clipboard">
                    <p class="text-sm font-medium text-gray-700">{{ 'eventMetadata'|trans({}, 'dashboard') }}</p>
                    <div class="relative rounded-md overflow-hidden">
                    <pre class="copyable-code relative rounded bg-gray-800 text-white p-4 font-mono text-xs overflow-x-auto whitespace-pre-wrap break-words"
                         data-clipboard-target="code">{{ event.eventMetadata|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                        <button type="button"
                                class="absolute top-2 right-2 flex items-center justify-center p-1.5 rounded-md bg-gray-700 hover:bg-gray-600 focus:ring-2 focus:ring-primary/50 transition"
                                title="{{ 'copyCommand.title'|trans({}, 'config_radsec') }}"
                                aria-label="{{ 'copyCommand.ariaLabel'|trans({}, 'config_radsec') }}"
                                data-action="click->clipboard#copyToClipboard">
                            <twig:ux:icon class="w-4 h-4 text-white" name="wba:copy" />
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
