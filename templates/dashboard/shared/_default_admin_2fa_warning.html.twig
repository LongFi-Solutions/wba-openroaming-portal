{% set isDefaultAdminEmail2FA = app.user
    and is_granted(constant('App\\Enum\\AdminRoleType::ROLE_SUPER_ADMIN').value)
    and app.user.isDefaultAdmin
    and app.user.twoFAtype == constant('App\\Enum\\UserTwoFactorAuthenticationStatus::EMAIL').value %}

{% if isDefaultAdminEmail2FA %}
    <div class="toast-error-dashboard relative mb-6">
        <twig:ux:icon name="wba:warning" class="w-5 h-5 mr-3 shrink-0 fill-current stroke-none" />
        <span>{{ 'defaultAdminEmailNotAvailable'|trans({'%command%': 'php bin/console reset:super-admin'}, 'base_configuration') }}</span>
    </div>
{% endif %}
