<div class="flex items-center justify-between mb-8 border-b-2 border-gray-300 pb-4">
    <div>
        <h1 class="text-3xl font-bold text-gray-800">
            {% if user.firstName or user.lastName %}
                {{ user.firstName }} {{ user.lastName }}
            {% else %}
                {{ user.uuid }}
            {% endif %}
        </h1>
    </div>

    <div class="flex items-center gap-2 flex-wrap justify-end">
        {% if user.bannedAt %}
            <span class="pill-error">{{ 'banned'|trans({}, 'show') }}</span>
        {% endif %}
        {% if user.deletedAt %}
            <span class="pill-error">{{ 'deleted'|trans({}, 'show') }}</span>
        {% endif %}
        {% if user.isVerified %}
            <span class="pill-success">{{ 'verified'|trans({}, 'show') }}</span>
        {% else %}
            <span class="pill-warning">{{ 'unverified'|trans({}, 'show') }}</span>
        {% endif %}

        {% if actions is defined %}
            {{ actions|raw }}
        {% endif %}
    </div>
</div>