<div class="flex items-center justify-between mb-8 border-b-2 border-gray-300 pb-4">
    <div>
        <h1 class="text-3xl font-bold text-gray-800">
            {% if user.firstName or user.lastName %}
                {{ user.firstName }} {{ user.lastName }}
            {% else %}
                {{ user.uuid }}
            {% endif %}
        </h1>
    </div>

    {% if showStatus is not defined or showStatus %}
        <div class="flex items-center gap-2 flex-wrap justify-end">
            {% if user.bannedAt %}
                <span class="pill-error">{{ 'banned'|trans({}, 'show') }}</span>
            {% endif %}
            {% if user.deletedAt %}
                <span class="pill-error">{{ 'deleted'|trans({}, 'show') }}</span>
            {% endif %}
            {% if user.isVerified %}
                <span class="pill-success">{{ 'verified'|trans({}, 'show') }}</span>
            {% else %}
                <span class="pill-warning">{{ 'unverified'|trans({}, 'show') }}</span>
            {% endif %}

            {% if actions is defined %}
                {{ actions|raw }}
            {% endif %}

            {% if actionsMenu is defined and actionsMenu %}
                <div class="relative" {{ stimulus_controller('nav-submenu') }}>
                    <button type="button"
                            {{ stimulus_action('nav-submenu', 'toggle') }}
                            class="p-2 rounded-full hover:bg-gray-100 cursor-pointer">
                        <twig:ux:icon name="wba:menu-dots" class="w-5 h-5 fill-current" />
                    </button>

                    <div class="hidden bg-white divide-y divide-gray-100 rounded-lg shadow min-w-max absolute right-0 mt-2 z-16"
                            {{ stimulus_target('nav-submenu', 'container') }}>
                        {{ include('dashboard/shared/_user_actions_dropdown.html.twig', {
                            user: actionsMenu.user,
                            isAdmin: actionsMenu.isAdmin,
                            delete_users: actionsMenu.delete_users,
                            formRevokeProfiles: actionsMenu.formRevokeProfiles,
                            userExternalAuths: actionsMenu.userExternalAuths,
                            currentUser: actionsMenu.currentUser ?? null,
                            showMoreDetails: actionsMenu.showMoreDetails ?? true,
                        }) }}
                    </div>
                </div>
            {% endif %}
        </div>
    {% endif %}
</div>
