{# Table Content - Network #}
<tr class="font-medium">

    {# Name #}
    <td class="p-4 pl-8">
        {{ network.name }}
    </td>

    {# Created At #}
    <td class="p-4 pl-8">
        {% if network.createdAt %}
            {{ network.createdAt|date('d/m/Y H:i') }}
        {% else %}
            <span class="pill-error">{{ 'noData'|trans({}, '_blacklist') }}</span>
        {% endif %}
    </td>

