<div class="flex items-center gap-2">

    {# Format selector #}
    <div class="flex items-center gap-1 bg-gray-100 rounded-lg p-[3px]">
        <label>
            <select data-model="exportFormat"
                    class="px-3 py-[5px] text-sm bg-transparent border-none outline-none text-gray-600 cursor-pointer">
                <option value="csv">CSV</option>
                <option value="json">JSON</option>
            </select>
        </label>
    </div>

    {# Export button #}
    <button type="button"
            data-action="live#action"
            data-live-action-param="exportLogs"
            class="flex items-center gap-2 rounded-md px-4 py-[7px]
                   bg-primary text-white text-sm font-medium
                   hover:opacity-90 transition-all duration-150">
        {{ 'exportActivityLogs'|trans({}, 'ActivityLogSearchForm') }}
    </button>
</div>
