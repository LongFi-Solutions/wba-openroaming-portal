{% extends '/dashboard/base.html.twig' %}

{% block container %}
    {{ form_start(form) }}
    {{ form_errors(form) }}

    <div class="grid gap-4 lg:grid-cols-2 xl:grid-cols-2 p-2 z-0" {{ stimulus_controller('sms-provider-type') }}>

        <div class="transition hover:-translate-y-1 hover:shadow bg-white rounded-md p-6 w-full lg:col-span-2" {{ stimulus_controller('card') }}>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">

                {# Provider Type #}
                <div class="flex flex-col h-full">
                    <div class="min-h-[88px]">
                        <div class="flex flex-row justify-between">
                            <div class="text-base font-medium text-center break-normal md:break-all">
                                <h1 class="text-base md:text-lg whitespace-nowrap">{{ 'smsProviderType'|trans({}, '_sms') }}</h1>
                            </div>
                            <label class="flex items-center bg-opacity-40">
                                <img class="w-6 cursor-pointer" {{ stimulus_target('card', 'button') }}
                                        {{ stimulus_action('card', 'show_info', 'mouseover')|stimulus_action('card', 'hide_info', 'mouseout') }}
                                     src="{{ asset('resources/logos/info_icon.svg') }}" alt="info_icon" />
                            </label>
                        </div>
                        {{ include('/dashboard/shared/settings_actions/_description.html.twig', {description: 'smsProviderTypeHelp'|trans({}, '_sms')}) }}
                    </div>
                    <div class="flex items-center space-x-2 mt-5">
                        {{ form_widget(form.smsProviderType, {
                            attr: {
                                class: 'form-widget',
                                'data-action': 'change->sms-provider-type#toggle',
                                'data-sms-provider-type-target': 'select',
                            },
                        }) }}
                    </div>
                    <div class="mt-2 text-center text-red-500 text-base">
                        {{ form_errors(form.smsProviderType) }}
                    </div>
                </div>

                {# Name #}
                <div class="flex flex-col h-full">
                    <div class="min-h-[88px]">
                        <div class="flex flex-row justify-between">
                            <div class="text-base font-medium text-center break-normal md:break-all">
                                <h1 class="text-base md:text-lg whitespace-nowrap">{{ 'name'|trans({}, '_sms') }}</h1>
                            </div>
                            <label class="flex items-center bg-opacity-40 invisible">
                                <img class="w-6" src="{{ asset('resources/logos/info_icon.svg') }}" alt="" />
                            </label>
                        </div>
                    </div>
                    <div class="flex items-center space-x-2 mt-5">
                        {{ form_widget(form.name, {attr: {class: 'form-widget'}}) }}
                    </div>
                    <div class="mt-2 text-center text-red-500 text-base">
                        {{ form_errors(form.name) }}
                    </div>
                </div>

                {# Test Mode #}
                <div class="flex flex-col h-full">
                    <div class="min-h-[88px]">
                        <div class="flex flex-row justify-between">
                            <div class="text-base font-medium text-center break-normal md:break-all">
                                <h1 class="text-base md:text-lg whitespace-nowrap">{{ 'testMode'|trans({}, '_sms') }}</h1>
                            </div>
                            <label class="flex items-center bg-opacity-40 invisible">
                                <img class="w-6" src="{{ asset('resources/logos/info_icon.svg') }}" alt="" />
                            </label>
                        </div>
                    </div>
                    <div class="flex items-center space-x-2 mt-5">
                        <label class="inline-flex items-center cursor-pointer">
                            {{ form_widget(form.testMode, {attr: {class: 'sr-only peer'}}) }}
                            <div class="relative w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-bg-lightGreen rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-yellow-500"></div>
                        </label>
                    </div>
                    <div class="mt-2 text-center text-red-500 text-base">
                        {{ form_errors(form.testMode) }}
                    </div>
                </div>

            </div>
        </div>

        {# ── Provider-specific configuration ──────────────────────────────
           Only the block matching the selected type is visible (toggled
           client-side by sms-provider-type, checking each card's
           data-provider-type attribute). A future provider type adds its
           own include here, following the same pattern. #}
        {{ include('dashboard/shared/settings_actions/sms_providers/partials/_budgetsms_fields.html.twig', {form: form}) }}

    </div>

    <div class="mt-8 divider-solid"></div>

    <div class="mt-6 flex flex-row w-full justify-end items-center gap-2 p-2">
        <a href="{{ path('admin_dashboard_settings_sms_providers') }}"
           class="text-sm hover:text-red-600 font-bold p-2 rounded-lg transition ease-in duration-300">
            {{ 'cancel'|trans({}, '_sms') }}
        </a>
        <button type="submit" class="btn-primary"
                onclick="return confirm('{{ 'saveChangesMessage'|trans({}, 'settings_actions_general')|e('js') }}')">
            {% if provider %}
                {{ 'saveProvider'|trans({}, '_sms') }}
            {% else %}
                {{ 'createProvider'|trans({}, '_sms') }}
            {% endif %}
        </button>
    </div>

    {{ form_rest(form) }}
    {{ form_end(form, {render_rest: false}) }}
{% endblock %}
