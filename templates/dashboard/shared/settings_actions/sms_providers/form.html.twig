{% extends '/dashboard/base.html.twig' %}

{% block container %}
    {{ form_start(form) }}
    {{ form_errors(form) }}

    <div class="grid gap-4 lg:grid-cols-2 xl:grid-cols-2 p-2 z-0" {{ stimulus_controller('sms-provider-type') }}>

        <div class="transition-all duration-200 hover:-translate-y-1 hover:shadow-md bg-white rounded-lg p-6 w-full lg:col-span-2" {{ stimulus_controller('card') }}>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 items-stretch">

                {# Provider Type #}
                <div class="flex flex-col h-full">
                    <div class="flex-grow flex flex-col">
                        <div class="flex flex-row justify-between items-start mb-2">
                            <label class="text-sm md:text-base font-semibold text-gray-800 break-words">
                                {{ 'smsProviderType'|trans({}, '_sms') }}
                            </label>
                            <button type="button" class="w-6 cursor-pointer opacity-60 hover:opacity-100 transition-opacity focus:outline-none"
                                    {{ stimulus_target('card', 'button') }}
                                    {{ stimulus_action('card', 'show_info', 'mouseenter')|stimulus_action('card', 'hide_info', 'mouseleave') }}>
                                <img src="{{ asset('resources/logos/info_icon.svg') }}" alt="Info" />
                            </button>
                        </div>
                        <div class="text-sm text-gray-500 mb-4">
                            {{ include('/dashboard/shared/settings_actions/_description.html.twig', {description: 'smsProviderTypeHelp'|trans({}, '_sms')}) }}
                        </div>
                    </div>

                    <div class="mt-auto w-full">
                        {{ form_widget(form.smsProviderType, {
                            attr: {
                                class: 'form-widget w-full',
                                'data-action': 'change->sms-provider-type#toggle',
                                'data-sms-provider-type-target': 'select',
                            },
                        }) }}
                        <div class="mt-1 text-sm text-red-500 min-h-[20px]">
                            {{ form_errors(form.smsProviderType) }}
                        </div>
                    </div>
                </div>

                {# Name #}
                <div class="flex flex-col h-full">
                    <div class="flex-grow flex flex-col">
                        <div class="flex flex-row justify-between items-start mb-2">
                            <label class="text-sm md:text-base font-semibold text-gray-800 break-words">
                                {{ 'name'|trans({}, '_sms') }}
                            </label>
                            <div class="w-6"></div>
                        </div>
                    </div>

                    <div class="mt-auto w-full">
                        {{ form_widget(form.name, {attr: {class: 'form-widget w-full'}}) }}
                        <div class="mt-1 text-sm text-red-500 min-h-[20px]">
                            {{ form_errors(form.name) }}
                        </div>
                    </div>
                </div>

                {# Test Mode #}
                <div class="flex flex-col h-full">
                    <div class="flex-grow flex flex-col">
                        <div class="flex flex-row justify-between items-start mb-2">
                            <label class="text-sm md:text-base font-semibold text-gray-800 break-words">
                                {{ 'testMode'|trans({}, '_sms') }}
                            </label>
                            <div class="w-6"></div>
                        </div>
                    </div>

                    <div class="mt-auto w-full">
                        {# Wrapper com h-[42px] (altura padrão de um input) para alinhar o toggle perfeitamente com os text inputs ao lado #}
                        <div class="flex items-center h-[42px]">
                            <label class="inline-flex items-center cursor-pointer">
                                {{ form_widget(form.testMode, {attr: {class: 'sr-only peer'}}) }}
                                <div class="relative w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-bg-lightGreen rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-yellow-500"></div>
                            </label>
                        </div>
                        <div class="mt-1 text-sm text-red-500 min-h-[20px]">
                            {{ form_errors(form.testMode) }}
                        </div>
                    </div>
                </div>

            </div>
        </div>

        {# ── Provider-specific configuration ──────────────────────────────
           Only the block matching the selected type is visible (toggled
           client-side by sms-provider-type, checking each card's
           data-provider-type attribute). A future provider type adds its
           own include here, following the same pattern. #}
        {{ include('dashboard/shared/settings_actions/sms_providers/partials/_budgetsms_fields.html.twig', {form: form}) }}

    </div>

    <div class="mt-8 divider-solid"></div>

    <div class="mt-6 flex flex-row w-full justify-end items-center gap-2 p-2">
        <a href="{{ path('admin_dashboard_settings_sms_providers') }}"
           class="text-sm hover:text-red-600 font-bold p-2 rounded-lg transition ease-in duration-300">
            {{ 'cancel'|trans({}, '_sms') }}
        </a>
        <button type="submit" class="btn-primary"
                onclick="return confirm('{{ 'saveChangesMessage'|trans({}, 'settings_actions_general')|e('js') }}')">
            {% if provider %}
                {{ 'saveProvider'|trans({}, '_sms') }}
            {% else %}
                {{ 'createProvider'|trans({}, '_sms') }}
            {% endif %}
        </button>
    </div>

    {{ form_rest(form) }}
    {{ form_end(form, {render_rest: false}) }}
{% endblock %}
