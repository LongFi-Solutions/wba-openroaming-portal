{% extends '/dashboard/base.html.twig' %}

{% macro paramRow(paramField) %}
    <div {{ stimulus_target('sms-provider-params', 'row') }}
            class="flex justify-center items-center gap-3">
        {{ form_widget(paramField.id) }}
        <div class="w-1/4">
            {{ form_widget(paramField.type, {
                attr: {class: 'form-widget'},
            }) }}
            <div class="text-red-500 text-sm">
                {{ form_errors(paramField.type) }}
            </div>
        </div>
        <div class="w-1/4">
            {{ form_widget(paramField.paramType, {
                attr: {
                    placeholder: 'e.g. username, userid, handle, from',
                    class: 'form-widget',
                },
            }) }}
            <div class="text-red-500 text-sm">
                {{ form_errors(paramField.paramType) }}
            </div>
        </div>
        <div class="w-1/2">
            {{ form_widget(paramField.value, {
                attr: {placeholder: 'value', class: 'form-widget'},
            }) }}
            <div class="text-red-500 text-sm">
                {{ form_errors(paramField.value) }}
            </div>
        </div>
        <button type="button"
                {{ stimulus_action('sms-provider-params', 'removeParam') }}
                class="hover:text-red-400 transition">
            <twig:ux:icon name="wba:trash" class="w-5 h-5 fill-none stroke-current" />
        </button>
    </div>
{% endmacro %}

{% block container %}
    {{ form_start(form) }}
    {{ form_errors(form) }}

    <div class="p-6 bg-white">
        <div class="relative mb-4">
            {{ form_label(form.smsProviderType, 'smsProviderType'|trans({}, '_sms'), {label_attr: {class: 'form-label'}}) }}
            {{ form_widget(form.smsProviderType, {attr: {class: 'form-widget'}}) }}
            <div class="text-red-500 m-2">
                {{ form_errors(form.smsProviderType) }}
            </div>
        </div>

        <div class="relative mb-4">
            {{ form_label(form.name, 'name'|trans({}, '_sms'), {label_attr: {class: 'form-label'}}) }}
            {{ form_widget(form.name, {attr: {class: 'form-widget'}}) }}
            <div class="text-red-500 m-2">
                {{ form_errors(form.name) }}
            </div>
        </div>

        <div class="relative mb-4 flex items-center gap-2">
            {{ form_widget(form.testMode) }}
            {{ form_label(form.testMode, 'testMode'|trans({}, '_sms'), {label_attr: {class: 'form-label'}}) }}
            <div class="text-red-500 m-2">
                {{ form_errors(form.testMode) }}
            </div>
        </div>

        {# ── Params ──────────────────────────────────────────────────────────── #}
        <div class="mt-6 lg:col-span-2 flex flex-col gap-4">
            <p class="font-bold">{{ 'params'|trans({}, '_sms') }}</p>
            {{ form_errors(form.params) }}

            <div {{ stimulus_controller('sms-provider-params', {
                prototype: _self.paramRow(form.params.vars.prototype),
                index: form.params|length,
            }) }}>
                <div {{ stimulus_target('sms-provider-params', 'list') }} class="flex flex-col gap-2">
                    {% for paramField in form.params %}
                        {{ _self.paramRow(paramField) }}
                    {% endfor %}
                </div>

                <button type="button"
                        {{ stimulus_action('sms-provider-params', 'addParam') }}
                        class="flex flex-row items-center justify-center gap-2 w-full mt-2 py-2 rounded-lg border-2 border-dashed border-gray-300 text-sm font-semibold text-gray-500 hover:border-lightGreen hover:text-lightGreen transition">
                    <twig:ux:icon name="wba:add" class="w-4 h-4 fill-current" />
                    {{ 'addParam'|trans({}, '_sms') }}
                </button>
            </div>
        </div>

        <div class="flex flex-row justify-end gap-4 md:w-full mt-6">
            <a href="{{ path('admin_dashboard_settings_sms_providers') }}"
               class="btn-secondary flex items-center justify-center">
                {{ 'cancel'|trans({}, '_sms') }}
            </a>
            <button type="submit" class="btn-primary">
                {% if provider %}
                    {{ 'saveProvider'|trans({}, '_sms') }}
                {% else %}
                    {{ 'createProvider'|trans({}, '_sms') }}
                {% endif %}
            </button>
        </div>
    </div>

    {{ form_rest(form) }}
    {{ form_end(form, {render_rest: false}) }}
{% endblock %}
