{# Test Credentials #}
<div class="lg:col-span-2 bg-white rounded-md p-6 w-full flex flex-col sm:flex-row items-start sm:items-center gap-4"
     data-provider-type="budgetsms">
    <button type="button"
            data-sms-provider-test-target="button"
            data-action="sms-provider-test#test"
            class="btn-secondary whitespace-nowrap">
        {{ 'testCredentials'|trans({}, '_sms') }}
    </button>
    <span data-sms-provider-test-target="result" class="hidden text-sm font-semibold"></span>
</div>
