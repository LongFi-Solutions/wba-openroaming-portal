{% extends '/dashboard/base.html.twig' %}

{% block title %}Map Page - Create Network{% endblock %}

{% block container %}

    <twig:EditNetworksForm
            :networkDTO="networkDTO"
            :data="data"
            :form="form"
            :network="network"
    >

        <div class="p-6 bg-white rounded-lg shadow-sm"
             data-controller="network-polygon map-geolocation"
             data-network-polygon-tooltip-value="{{ 'deletePolygonTooltip'|trans({}, '_map') }}">

        <div class="mb-6">
            <h2 class="text-xl sm:text-2xl font-semibold text-gray-800">
                {{ 'editNetwork'|trans({}, '_map') }}
            </h2>
        </div>

        {{ form_start(form) }}

        {{ form_widget(form.geometryJson, {'attr': {'data-network-polygon-target': 'geometryJson'}}) }}

        <div class="mx-auto grid grid-cols-1 lg:grid-cols-2 gap-6">

            {# NAME #}
            <div class="relative lg:col-span-2">
                {{ form_label(form.name, 'networkName'|trans({}, '_map'), {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(form.name, {attr: {class: 'form-widget', placeholder: 'networkNamePlaceHolder'|trans({}, '_map')}}) }}
                <div class="text-red-500 m-2 text-sm">
                    {{ form_errors(form.name) }}
                </div>
            </div>

            {# DESCRIPTION #}
            <div class="relative lg:col-span-2">
                {{ form_label(form.description, 'networkDescription'|trans({}, '_map'), {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(form.description, {attr: {
                    class: 'form-widget min-h-[100px]',
                    rows: '4',
                    placeholder: 'networkDescriptionPlaceHolder'|trans({}, '_map')
                }}) }}
                <div class="text-red-500 m-2 text-sm">
                    {{ form_errors(form.description) }}
                </div>
            </div>

            {# GEOMETRY #}
            <div class="lg:col-span-2 mt-4">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 mb-3">
                    <div>
                        <label class="form-label block font-semibold text-gray-700">
                            {{ 'drawPolygon'|trans({}, '_map') }}
                        </label>
                        <p class="text-xs text-gray-400">
                            {{ 'drawPolygonDescription'|trans({}, '_map') }}
                        </p>
                    </div>

                    <div class="flex gap-2 w-full sm:w-auto">
                        <button type="button"
                                data-action="click->network-polygon#resetPolygon"
                                class="px-3 py-1.5 text-xs font-medium text-red-600 bg-red-50 hover:bg-red-100 rounded border border-red-200 transition w-1/2 sm:w-auto">
                            {{ 'clean'|trans({}, '_map') }}
                        </button>
                        <button type="button"
                                data-action="click->network-polygon#finishPolygon"
                                class="px-3 py-1.5 text-xs font-medium text-white bg-blue-600 hover:bg-blue-700 rounded shadow-sm transition w-1/2 sm:w-auto">
                            {{ 'closePolygon'|trans({}, '_map') }}
                        </button>
                    </div>
                </div>

                <div class="w-full h-[450px] rounded-lg border border-gray-200 shadow-inner overflow-hidden z-10">
                    {{ ux_map(this.map, {
                        'class': 'w-full h-full min-h-[450px]',
                        'data-action': 'ux:map:connect->map-geolocation#_onConnect ux:map:connect->network-polygon#_onConnect'
                    }) }}
                </div>
                <div class="text-red-500 m-2 text-sm">
                    {{ form_errors(form.geometryJson) }}

                    {% for error in form.vars.errors %}
                        {% if error.cause is defined and error.cause is not null %}
                            {% if error.cause.propertyPath is defined and error.cause.propertyPath == 'data.geometryJson' %}
                                <p>{{ error.message }}</p>
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>

        {# ACTION BUTTONS #}
        <div class="flex flex-row justify-end gap-4 md:w-full mt-8 pt-4 border-t border-gray-100">
            <a href="{{ path('admin_dashboard_map') }}" class="btn-secondary flex items-center justify-center">
                {{ 'return'|trans({}, '_map') }}
            </a>
            <button type="submit" class="btn-primary">
                {{ 'edit'|trans({}, '_map') }}
            </button>
        </div>

        {{ form_rest(form) }}
        {{ form_end(form) }}
    </div>

    </twig:EditNetworksForm>
{% endblock %}