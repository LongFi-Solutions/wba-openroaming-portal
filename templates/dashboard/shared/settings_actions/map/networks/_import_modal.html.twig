<div id="import-modal" class="fixed inset-0 z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    {# Backdrop escuro de fundo #}
    <div id="btn-close-backdrop" class="fixed inset-0 bg-gray-600 bg-opacity-50 transition-opacity"></div>

    {# Posicionamento do Modal #}
    <div class="fixed inset-0 z-50 w-screen overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">

            <div class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-md border border-gray-200">

                {# Formulário Symfony que aponta para a tua rota de processamento #}
                <form action="{{ path('admin_dashboard_map_import') }}" method="POST" enctype="multipart/form-data">

                    {# Cabeçalho do Modal #}
                    <div class="bg-gray-50 px-6 py-4 border-b border-gray-200 flex justify-between items-center">
                        <h3 class="text-base font-semibold leading-6 text-gray-900" id="modal-title">
                            {{ 'importCsvTitle'|trans({}, '_network')|default('Import OpenRoaming Data') }}
                        </h3>
                        <button type="button" id="btn-close-x" class="text-gray-400 hover:text-gray-600 focus:outline-none">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>

                    {# Corpo do Modal #}
                    <div class="bg-white px-6 py-6 space-y-4">
                        <p class="text-sm text-gray-500">
                            {{ 'importCsvHelp'|trans({}, '_network')|default('Select the flat CSV file containing the network and Access Point data. Ensure headers match the template.') }}
                        </p>

                        {# Zona do Input do Ficheiro #}
                        <div class="mt-2">
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                {{ 'csvFileLabel'|trans({}, '_network')|default('CSV File (.csv)') }}
                            </label>
                            <input type="file"
                                   name="import_file"
                                   accept=".csv"
                                   required
                                   class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200 border border-gray-300 rounded-md p-1 focus:outline-none focus:border-veryDarkButton" />
                        </div>

                        {# Aviso visual de segurança #}
                        <div class="bg-amber-50 border-l-4 border-amber-400 p-3 rounded">
                            <div class="flex">
                                <div class="shrink-0">
                                    <svg class="h-5 w-5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                                    </svg>
                                </div>
                                <div class="ml-3">
                                    <p class="text-xs text-amber-700">
                                        {{ 'importWarning'|trans({}, '_network')|default('Uploading will process data sequentially. Duplicate network names will group APs under the same network entry.') }}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Rodapé do Modal com Botões de Ação #}
                    <div class="bg-gray-50 px-6 py-3 flex flex-row-reverse gap-3 border-t border-gray-200">
                        <button type="submit" class="btn-primary px-4 py-2 text-sm min-w-[100px] cursor-pointer">
                            {{ 'upload'|trans({}, '_network')|default('Upload') }}
                        </button>
                        <button type="button" id="btn-close-cancel" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none transition-colors cursor-pointer">
                            {{ 'cancel'|trans({}, '_network')|default('Cancelar') }}
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

{# Script Vanilla JS nativo para abrir/fechar o Modal #}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const modal = document.getElementById('import-modal');
        const btnOpen = document.getElementById('btn-open-import');
        const btnCloseBackdrop = document.getElementById('btn-close-backdrop');
        const btnCloseX = document.getElementById('btn-close-x');
        const btnCloseCancel = document.getElementById('btn-close-cancel');

        const openModal = () => modal.classList.remove('hidden');
        const closeModal = () => modal.classList.add('hidden');

        if (btnOpen) btnOpen.addEventListener('click', openModal);
        if (btnCloseBackdrop) btnCloseBackdrop.addEventListener('click', closeModal);
        if (btnCloseX) btnCloseX.addEventListener('click', closeModal);
        if (btnCloseCancel) btnCloseCancel.addEventListener('click', closeModal);

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
                closeModal();
            }
        });
    });
</script>