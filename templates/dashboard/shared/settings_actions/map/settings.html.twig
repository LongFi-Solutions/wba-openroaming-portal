{% extends '/dashboard/base.html.twig' %}

{% block container %}

    <twig:MapSettingsForm :form="form">

    <div class="p-6 bg-white rounded-lg shadow-sm"
         data-controller="custom-map-picker"
         data-custom-map-picker-marker-icon-value="{{ ux_icon('wba:access-point-point', {class: 'fill-none stroke-current'})|e('html_attr') }}">

        {{ form_start(form) }}

        {# DEFAULT CENTER & GEOLOCATION #}
        <div>
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-4">
                <div>
                    <h3 class="text-lg font-semibold text-green-600 tracking-wide">
                        {{ 'mapDefaultCenter'|trans({}, '_map') }}
                    </h3>
                    <p class="text-xs text-gray-400 mt-1">
                        {{ 'mapDefaultCenterDescription'|trans({}, '_map') }}
                    </p>
                </div>
            </div>

            {# INTERACTIVE MAP #}
            <div class="relative z-0 overflow-hidden w-full h-[400px] rounded-2xl coverage-map-public shadow-inner border border-gray-100"
                 data-live-ignore>
                {{ ux_map(this.map, {
                    style: 'height: 100%; width: 100%;',
                    'data-action': 'ux:map:connect->custom-map-picker#_onConnect',
                }) }}
            </div>

            <p class="text-xs text-gray-400 mt-2 ml-1">
                {{ 'clickToSetCoordinates'|trans({}, '_map') }}
            </p>

            {# BUTTONS TOOLBAR #}
            <div class="relative flex flex-col sm:flex-row items-center justify-center w-full mt-4 gap-3 sm:gap-0">
                <div class="sm:absolute right-0">
                    <button type="button"
                            data-action="click->custom-map-picker#clearCoordinates"
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-red-600 bg-red-50 hover:bg-red-100 rounded-lg border border-red-200 transition">
                        <twig:ux:icon name="wba:trash" class="w-3.5 h-3.5 fill-none stroke-current" />
                        {{ 'clearCoordinates'|trans({}, '_map') }}
                    </button>
                </div>
            </div>

            <hr class="border-gray-100 mt-6 mb-6">

            {# FORM FIELDS (COORDINATES & ZOOM) #}
            <div class="mb-4">
                <h3 class="text-md font-semibold text-gray-800 tracking-wide">
                    {{ 'exactCoordinatesAndZoom'|trans({}, '_map') }}
                </h3>
                <p class="text-xs text-gray-400 mt-1">
                    {{ 'exactCoordinatesDescription'|trans({}, '_map') }}
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

                {# LATITUDE #}
                <div class="relative">
                    {{ form_label(form.latitude, 'latitude'|trans({}, '_map'), {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.latitude, {attr: {
                        class: 'form-widget',
                        'data-custom-map-picker-target': 'latitude',
                        'data-action': 'change->custom-map-picker#syncMap',
                    }}) }}

                    <p class="text-gray-400 text-sm mt-1 ml-1">
                        {{ 'latitudeDescription'|trans({}, '_map') }}
                    </p>

                    <div class="text-red-500 m-2 text-sm">
                        {{ form_errors(form.latitude) }}
                    </div>
                </div>

                {# LONGITUDE #}
                <div class="relative">
                    {{ form_label(form.longitude, 'longitude'|trans({}, '_map'), {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.longitude, {attr: {
                        class: 'form-widget',
                        'data-custom-map-picker-target': 'longitude',
                        'data-action': 'change->custom-map-picker#syncMap',
                    }}) }}

                    <p class="text-gray-400 text-sm mt-1 ml-1">
                        {{ 'longitudeDescription'|trans({}, '_map') }}
                    </p>

                    <div class="text-red-500 m-2 text-sm">
                        {{ form_errors(form.longitude) }}
                    </div>
                </div>

                {# ZOOM #}
                <div class="relative pb-2">
                    {{ form_label(form.zoom, 'zoomLevel'|trans({}, '_map'), {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.zoom, {attr: {
                        class: 'form-widget',
                        'data-custom-map-picker-target': 'zoom',
                        'data-action': 'change->custom-map-picker#syncMap'
                    }}) }}

                    <p class="text-gray-400 text-sm mt-1 ml-1">
                        {{ 'zoomDescription'|trans({}, '_map') }} (0 - 19)
                    </p>

                    <div class="text-red-500 m-2 text-sm">
                        {{ form_errors(form.zoom) }}
                    </div>
                </div>
            </div>
        </div>

        {% if is_granted(constant('App\\Security\\Voter\\UserAuthenticationVoter::MAP_WRITE')) %}
            {# ACTION BUTTONS #}
            <div class="flex flex-row justify-end gap-4 md:w-full mt-8 pt-4 border-t border-gray-100">
                <button type="submit" class="btn-primary">
                    {{ 'saveSettings'|trans({}, '_map') }}
                </button>
            </div>
        {% endif %}

        {{ form_rest(form) }}
        {{ form_end(form) }}

    </div>

    </twig:MapSettingsForm>

{% endblock %}